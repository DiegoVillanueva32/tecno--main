{%- comment -%}
  Tecno+ Mundo Gamer Feature Banner (Exact React Replica)
{%- endcomment -%}

<section id="gaming" class="tp-dark-bg tp-section">
  <div class="tp-container">
    <div class="tp-feature">
      {%- comment -%} Left Column: Texts and CTA {%- endcomment -%}
      <div class="tp-feature-copy">
        <span class="tp-gamer-eyebrow">
          {{ section.settings.eyebrow | default: 'MUNDO GAMER' }}
        </span>
        <h2>{{ section.settings.title | default: 'Consola Game Stick Pro 4K' }}</h2>
        <p>
          {{ section.settings.description | default: 'Juega donde quieras: compatible con televisores, computadores y pantallas HDMI. Incluye 2 controles inalámbricos, miles de juegos retro clásicos y resolución 4K Plug & Play.' }}
        </p>
        <strong class="tp-gamer-price">{{ section.settings.price | default: '$180.000 COP' }}</strong>
        <div>
          <button
            type="button"
            class="tp-gamer-btn"
            style="cursor: pointer; border: none;"
            onclick="if(window.addToCheckout){ window.addToCheckout({ id: 'consola-gamestick-4k', title: 'Consola Game Stick Pro 4K', price: 180000, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/8387D90E-BC01-4E57-8D38-682507F7BB47.png?v=1791928275', quantity: 1 }, { openDrawer: true }); } else if(window.openCheckout){ window.openCheckout({ id: 'consola-gamestick-4k', title: 'Consola Game Stick Pro 4K', price: 180000, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/8387D90E-BC01-4E57-8D38-682507F7BB47.png?v=1791928275', quantity: 1 }); }"
          >
            <span>🛒 {{ section.settings.btn_text | default: 'Añadir consola al carrito' }}</span>
            <span>+</span>
          </button>
        </div>
      </div>

      {%- comment -%} Right Column: Studio Showcase White Card {%- endcomment -%}
      <div class="tp-feature-img">
        <div class="tp-gamer-white-card" id="gamer-carousel-{{ section.id }}">
          {%- comment -%} Red Progress Bar {%- endcomment -%}
          <div class="tp-gamer-progress-bar"></div>

          {%- comment -%} Slide Images {%- endcomment -%}
          <div class="tp-gamer-slides-wrap">
            <div class="tp-gamer-slide active" data-index="0">
              <img src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/8387D90E-BC01-4E57-8D38-682507F7BB47.png?v=1791928275" alt="Consola Game Stick Pro 4K" loading="lazy">
            </div>
            <div class="tp-gamer-slide" data-index="1">
              <img src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/BA9C7E78-E34B-46CE-83D6-15CCBC0A35B4.png?v=1791928275" alt="Game Stick Pro 4K Controles" loading="lazy">
            </div>
            <div class="tp-gamer-slide" data-index="2">
              <img src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/75E85BF7-87F5-4552-AD34-A1B8DA66A2D9.png?v=1791928274" alt="Game Stick Pro 4K Empaque" loading="lazy">
            </div>
          </div>

          {%- comment -%} Navigation Arrows {%- endcomment -%}
          <button type="button" class="tp-gamer-nav-arrow tp-gamer-prev" onclick="moveGamerSlide(-1)" aria-label="Imagen anterior">
            ‹
          </button>
          <button type="button" class="tp-gamer-nav-arrow tp-gamer-next" onclick="moveGamerSlide(1)" aria-label="Imagen siguiente">
            ›
          </button>

          {%- comment -%} Carousel Dots {%- endcomment -%}
          <div class="tp-gamer-dots">
            <span class="tp-gamer-dot active" onclick="setGamerSlide(0)"></span>
            <span class="tp-gamer-dot" onclick="setGamerSlide(1)"></span>
            <span class="tp-gamer-dot" onclick="setGamerSlide(2)"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tp-dark-bg {
    background: #ffffff;
    padding: 60px 0;
  }

  .tp-feature {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    background: #111111 !important;
    color: #ffffff !important;
    border-radius: 34px !important;
    overflow: hidden !important;
    min-height: 440px !important;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15) !important;
  }

  .tp-feature-copy {
    padding: 55px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }

  .tp-gamer-eyebrow {
    font-size: 11px !important;
    letter-spacing: 0.15em !important;
    font-weight: 800 !important;
    color: #e02424 !important;
    text-transform: uppercase !important;
    display: block !important;
    margin-bottom: 8px !important;
  }

  .tp-feature-copy h2 {
    font-size: clamp(34px, 4.5vw, 48px) !important;
    line-height: 1.05 !important;
    color: #ffffff !important;
    margin: 10px 0 16px !important;
    font-weight: 800 !important;
    letter-spacing: -0.04em !important;
  }

  .tp-feature-copy p {
    color: #b5b5b5 !important;
    line-height: 1.65 !important;
    max-width: 480px !important;
    margin: 0 !important;
    font-size: 14.5px !important;
  }

  .tp-gamer-price {
    display: block !important;
    font-size: 26px !important;
    margin: 22px 0 !important;
    font-weight: 800 !important;
    color: #ffffff !important;
  }

  .tp-gamer-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    background: #e02424 !important;
    color: #ffffff !important;
    padding: 13px 26px !important;
    border-radius: 999px !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: background 0.2s, transform 0.2s !important;
    box-shadow: 0 4px 14px rgba(224, 36, 36, 0.4) !important;
    width: fit-content !important;
  }

  .tp-gamer-btn:hover {
    background: #b91c1c !important;
    transform: translateY(-2px) !important;
  }

  /* Right Side: White Showcase Card */
  .tp-feature-img {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 40px !important;
    background: transparent !important;
  }

  .tp-gamer-white-card {
    position: relative !important;
    width: 100% !important;
    max-width: 460px !important;
    height: 360px !important;
    background: #ffffff !important;
    border-radius: 26px !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35) !important;
  }

  .tp-gamer-progress-bar {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 4px !important;
    background: #e02424 !important;
    z-index: 15 !important;
  }

  .tp-gamer-slides-wrap {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .tp-gamer-slide {
    position: absolute !important;
    inset: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 24px !important;
    opacity: 0 !important;
    transform: scale(0.96) !important;
    transition: opacity 0.5s ease, transform 0.5s ease !important;
    pointer-events: none !important;
  }

  .tp-gamer-slide.active {
    opacity: 1 !important;
    transform: scale(1) !important;
    pointer-events: auto !important;
  }

  .tp-gamer-slide img {
    max-width: 90% !important;
    max-height: 250px !important;
    object-fit: contain !important;
    display: block !important;
    margin: 0 auto !important;
  }

  /* Arrows */
  .tp-gamer-nav-arrow {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 32px !important;
    height: 32px !important;
    border-radius: 50% !important;
    background: rgba(0, 0, 0, 0.08) !important;
    border: none !important;
    color: #111111 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    font-size: 20px !important;
    line-height: 1 !important;
    z-index: 20 !important;
    transition: background 0.2s, transform 0.2s !important;
  }

  .tp-gamer-nav-arrow:hover {
    background: rgba(0, 0, 0, 0.18) !important;
    transform: translateY(-50%) scale(1.1) !important;
  }

  .tp-gamer-prev {
    left: 12px !important;
  }

  .tp-gamer-next {
    right: 12px !important;
  }

  /* Dots */
  .tp-gamer-dots {
    position: absolute !important;
    bottom: 12px !important;
    left: 0 !important;
    right: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    z-index: 20 !important;
  }

  .tp-gamer-dot {
    width: 7px !important;
    height: 7px !important;
    border-radius: 50% !important;
    background: rgba(0, 0, 0, 0.2) !important;
    cursor: pointer !important;
    transition: all 0.25s ease !important;
  }

  .tp-gamer-dot.active {
    width: 18px !important;
    border-radius: 999px !important;
    background: #e02424 !important;
  }

  @media (max-width: 900px) {
    .tp-feature {
      grid-template-columns: 1fr !important;
      border-radius: 28px !important;
    }
    .tp-feature-copy {
      padding: 36px 24px 20px !important;
      text-align: center !important;
    }
    .tp-feature-copy p {
      margin: 0 auto !important;
    }
    .tp-feature-copy div {
      display: flex !important;
      justify-content: center !important;
    }
    .tp-feature-img {
      padding: 10px 20px 36px !important;
    }
    .tp-gamer-white-card {
      height: 310px !important;
    }
  }
</style>

<script>
  (function() {
    var cur = 0;
    var container = document.getElementById('gamer-carousel-{{ section.id }}');
    if (!container) return;
    var slides = container.querySelectorAll('.tp-gamer-slide');
    var dots = container.querySelectorAll('.tp-gamer-dot');

    window.setGamerSlide = function(idx) {
      if (!slides.length) return;
      cur = (idx + slides.length) % slides.length;
      slides.forEach(function(s, i) {
        s.classList.toggle('active', i === cur);
      });
      dots.forEach(function(d, i) {
        d.classList.toggle('active', i === cur);
      });
    };

    window.moveGamerSlide = function(delta) {
      window.setGamerSlide(cur + delta);
    };

    setInterval(function() {
      window.moveGamerSlide(1);
    }, 5500);
  })();
</script>

{% schema %}
{
  "name": "Tecno+ Mundo Gamer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "MUNDO GAMER"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Consola Game Stick Pro 4K"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Juega donde quieras: compatible con televisores, computadores y pantallas HDMI. Incluye 2 controles inalámbricos, miles de juegos retro clásicos y resolución 4K Plug & Play."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Precio destacado",
      "default": "$180.000 COP"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Texto del botón",
      "default": "Añadir consola al carrito"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Tecno+ Mundo Gamer"
    }
  ]
}
{% endschema %}

      var nameUpper = (item.name || "").toUpperCase();
      if (code === "9081" || item.id === "bateria-iph-13-pro-9081" || nameUpper.indexOf("BATERIA IPH 13 PRO") !== -1) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/bateria-iph-13-pro.jpg?v=1791928269";
      }
      if (code === "515" || item.id === "bateria-9v-tronex-515" || nameUpper.indexOf("BATERIA 9V TRONEX") !== -1) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/bateria-9v-tronex.png?v=1791928271";
      }
      if (code === "R03" || item.id === "bateria-triple-aaa-tronex-r03" || nameUpper.indexOf("BATERIA TRIPLE AAA TRONEX") !== -1) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/bateria-aaa-tronex.jpg?v=1791928269";
      }
      if (code === "CMB-ACC-01" || (code.indexOf("S25") !== -1 && item.category === "Combos")) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-samsung.png?v=1791928273";
      }
      if (code === "CMB-REDMI15C-01" || (code.indexOf("REDMI") !== -1 && item.category === "Combos")) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-redmi15c.jpg?v=1791928273";
      }
      if (code === "CMB-SAMS-A07-01" || (code.indexOf("A07") !== -1 && item.category === "Combos")) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-samsung-a07-forro-silicona-vidrio.jpg?v=1791928272";
      }
      if (code === "9126" || item.id === "vidrios-templados-9126" || nameUpper.indexOf("VIDRIOS TEMPLADOS") !== -1) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/vidrio-templado-celular.jpg?v=1791928273";

    var isCurrentVidrio = false;

    function refreshModalPriceDisplay() {
      if (!currentModalItem) return;
      var basePrice = Number(currentModalItem.price) || 0;
      var glassExtra = (isCurrentPhone && (currentModalGlass === "templado" || currentModalGlass === "antiespia")) ? 10000 : 0;
      var unitPrice = basePrice + glassExtra;
      var grandTotal = unitPrice * currentModalQty;

      var totalDisplay = document.getElementById("tp-modal-total-display");
      if (totalDisplay) totalDisplay.textContent = formatCop(grandTotal);

      var btnText = document.getElementById("tp-modal-btn-label");
      if (btnText) {
        btnText.textContent = "🛒 Añadir al carrito • " + formatCop(grandTotal);
      }
    }

    window.adjustModalQty = function(delta) {
      if (!currentModalItem) return;
      var newQ = currentModalQty + delta;
      if (newQ < 1) newQ = 1;
      var maxStock = currentModalItem.stock > 0 ? currentModalItem.stock : 99;
      if (newQ > maxStock) newQ = maxStock;
      currentModalQty = newQ;
      var qEl = document.getElementById("tp-modal-qty-val");
      if (qEl) qEl.textContent = currentModalQty;
      refreshModalPriceDisplay();
    };

    window.setModalGlassChoice = function(val) {
      currentModalGlass = val;
      refreshModalPriceDisplay();
    };

    window.setModalGlassModel = function(val) {
      currentModalGlassModel = val;
    };

    // Añadir producto(s) desde el modal al carrito sin borrar los anteriores
    window.proceedModalAddToCart = function(openDrawer) {
      if (!currentModalItem) return;
      var itemsToBuy = [];
      var qty = currentModalQty;

      if (isCurrentVidrio) {
        var modelSelect = document.getElementById("tp-glass-model-select");
        var selectedModel = modelSelect ? modelSelect.value : currentModalGlassModel;
        itemsToBuy.push({
          id: (currentModalItem.id || currentModalItem.code) + "-" + selectedModel.toLowerCase().replace(/[^a-z0-9]/g, "-"),
          title: currentModalItem.name + " (" + selectedModel + ")",
          price: currentModalItem.price,
          image: currentModalImg,
          quantity: qty
        });
      } else {
        itemsToBuy.push({
          id: currentModalItem.id || currentModalItem.code,
          title: currentModalItem.name,
          price: currentModalItem.price,
          image: currentModalImg,
          quantity: qty
        });

        if (isCurrentPhone && (currentModalGlass === "templado" || currentModalGlass === "antiespia")) {
          var isAnti = currentModalGlass === "antiespia";
          itemsToBuy.push({
            id: isAnti ? "vidrios-antiespia-9139" : "vidrios-templados-9126",
            title: (isAnti ? "🔒 Vidrio Antiespía Privacy 9D" : "🛡️ Vidrio Templado 9D HD") + " (para " + currentModalItem.name + ")",
            price: 10000,
            image: isAnti ? "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/vidrio-antiespia-celular.jpg?v=1791928273" : "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/vidrio-templado-celular.jpg?v=1791928273",
            quantity: qty
          });
        }
      }

      window.closeModal();
      if (window.addToCheckout) {
        window.addToCheckout(itemsToBuy, { openDrawer: !!openDrawer });
      } else if (window.openCheckout) {
        window.openCheckout(itemsToBuy);
      }
    };

    window.proceedModalCheckout = function() {
      window.proceedModalAddToCart(true);
    };

    // Agregar producto rápido desde la tarjeta del catálogo
    window.handleCatalogItemAdd = function(btn, itemId) {
      if (!rawItems || !itemId) return;
      var found = rawItems.find(function(it) {
        return (it.id === itemId) || (it.code === itemId);
      });
      if (!found) return;

      var nameNorm = (found.name || "").toUpperCase();
      var isVidrio = (found.code === "9126" || found.code === "9139" || nameNorm.indexOf("VIDRIOS TEMPLADOS") !== -1 || nameNorm.indexOf("VIDRIOS ANTIESPIA") !== -1 || nameNorm.indexOf("VIDRIOS ANTIESPÍA") !== -1);

      // Si requiere modelo de teléfono (vidrios), abrir modal para selección precisa
      if (isVidrio) {
        openModal(found, resolveItemImage(found));
        return;
      }

      var origHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span>✓ Agregado</span><span>🛒</span>';
      btn.style.background = '#16a34a';

      var itemPayload = {
        id: found.id || found.code,
        title: found.name,
        price: found.price,
        image: resolveItemImage(found),
        quantity: 1
      };

      if (window.addToCheckout) {
        window.addToCheckout(itemPayload, { openDrawer: false });
      } else if (window.openCheckout) {
        window.openCheckout(itemPayload);
      }

      setTimeout(function() {
        btn.innerHTML = origHtml;
        btn.disabled = false;
        btn.style.background = '';
      }, 1800);
    };

    window.openModal = function(item, imgUrl) {
      var modal = document.getElementById("tp-product-modal");
      var content = document.getElementById("modal-content");
      if (!modal || !content) return;

      currentModalItem = item;
      currentModalImg = imgUrl;
      currentModalQty = 1;
      currentModalGlass = "none";
      currentModalGlassModel = "iPhone 16 Pro Max";

      var nameNorm = (item.name || "").toUpperCase();
      isCurrentPhone = (item.category === "Celulares") || (nameNorm.indexOf("IPHONE") !== -1 || nameNorm.indexOf("SAMSUNG GALAXY S") !== -1 || nameNorm.indexOf("REDMI") !== -1) && nameNorm.indexOf("COMBO") === -1 && nameNorm.indexOf("CARGADOR") === -1 && nameNorm.indexOf("VIDRIO") === -1 && nameNorm.indexOf("FORRO") === -1 && nameNorm.indexOf("CABLE") === -1;
      isCurrentVidrio = (item.code === "9126" || item.code === "9139" || nameNorm.indexOf("VIDRIOS TEMPLADOS") !== -1 || nameNorm.indexOf("VIDRIOS ANTIESPIA") !== -1 || nameNorm.indexOf("VIDRIOS ANTIESPÍA") !== -1);

      var badgeHtml = item.badge ? '<span class="tp-card-badge" style="position: static; margin-left: 6px;">' + item.badge + '</span>' : '';

      var rawPhotos = (item.images && item.images.length > 0) ? item.images : [imgUrl];
      var photosList = rawPhotos.map(function(p) {
        return resolveSingleUrl(p) || p;
      }).filter(function(u) {
        return u && (u.indexOf("http") === 0 || u.indexOf("//") === 0 || u.indexOf("cdn.shopify.com") !== -1 || u.indexOf("/cdn/") !== -1);
      });
      if (photosList.length === 0) photosList = [imgUrl];

      var thumbsHtml = '';
      if (photosList.length > 1) {
        thumbsHtml = '<div class="tp-modal-thumbs" style="display: flex; gap: 8px; justify-content: center; margin-top: 10px; overflow-x: auto; padding-bottom: 4px; max-width: 100%;">';
        photosList.forEach(function(pUrl, idx) {
          thumbsHtml += '<img src="' + pUrl + '" alt="Vista ' + (idx + 1) + '" style="width: 48px; height: 48px; object-fit: contain; border-radius: 8px; border: 2px solid ' + (idx === 0 ? '#e02424' : '#e5e7eb') + '; cursor: pointer; background: #fff; padding: 2px;" onclick="document.getElementById(\'tp-modal-main-img\').src=\'' + pUrl + '\'; this.parentElement.querySelectorAll(\'img\').forEach(function(el){ el.style.borderColor=\'#e5e7eb\'; }); this.style.borderColor=\'#e02424\';">';
        });
        thumbsHtml += '</div>';
      }

      var formattedDesc = (item.description || 'Producto 100% original con garantía oficial de Tecno+ y despacho rápido de 24 a 48 horas a toda Colombia.')
        .replace(/\n\n/g, '<br><br>')
        .replace(/\n/g, '<br>');

      // Selector de vidrio para celulares
      var glassSelectionHtml = '';
      if (isCurrentPhone) {
        glassSelectionHtml =
          '<div style="margin-bottom: 16px; background: #fff5f5; border: 1.5px solid #fecaca; border-radius: 16px; padding: 14px;">' +
            '<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">' +
              '<span style="font-size: 16px;">🛡️</span>' +
              '<span style="font-size: 12px; font-weight: 800; color: #991b1b; text-transform: uppercase;">¿Deseas incluir vidrio protector para este celular?</span>' +
            '</div>' +
            '<div style="display: flex; flex-direction: column; gap: 6px;">' +
              '<label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #374151; cursor: pointer; background: #fff; padding: 8px 12px; border-radius: 10px; border: 1px solid #e5e7eb;">' +
                '<input type="radio" name="tp-glass-choice" value="none" checked onchange="window.setModalGlassChoice(this.value)">' +
                '<span>Sin vidrio adicional (solo el teléfono)</span>' +
              '</label>' +
              '<label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #111; cursor: pointer; background: #fff; padding: 8px 12px; border-radius: 10px; border: 1px solid #e5e7eb;">' +
                '<input type="radio" name="tp-glass-choice" value="templado" onchange="window.setModalGlassChoice(this.value)">' +
                '<span>🛡️ Vidrio Templado 9D HD (+ $10.000 COP)</span>' +
              '</label>' +
              '<label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #111; cursor: pointer; background: #fff; padding: 8px 12px; border-radius: 10px; border: 1px solid #e5e7eb;">' +
                '<input type="radio" name="tp-glass-choice" value="antiespia" onchange="window.setModalGlassChoice(this.value)">' +
                '<span>🔒 Vidrio Antiespía Privacy 9D (+ $10.000 COP)</span>' +
              '</label>' +
            '</div>' +
          '</div>';
      }

      // Selector de modelo para productos de Vidrios
      var glassModelHtml = '';
      if (isCurrentVidrio) {
        glassModelHtml =
          '<div style="margin-bottom: 16px; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 16px; padding: 14px;">' +
            '<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">' +
              '<span style="font-size: 16px;">📱</span>' +
              '<span style="font-size: 12px; font-weight: 800; color: #166534; text-transform: uppercase;">Selecciona el modelo de celular para tu vidrio:</span>' +
            '</div>' +
            '<select id="tp-glass-model-select" onchange="window.setModalGlassModel(this.value)" style="width: 100%; border: 1.5px solid #86efac; border-radius: 10px; padding: 10px 12px; font-size: 13px; font-weight: 700; background: #fff; color: #111; outline: none;">' +
              '<optgroup label="Apple / iPhone">' +
                '<option value="iPhone 18 Pro Max">iPhone 18 Pro Max</option>' +
                '<option value="iPhone 17 Pro Max">iPhone 17 Pro Max</option>' +
                '<option value="iPhone 16 Pro Max" selected>iPhone 16 Pro Max</option>' +
                '<option value="iPhone 16 Pro">iPhone 16 Pro</option>' +
                '<option value="iPhone 16 / 16 Plus">iPhone 16 / 16 Plus</option>' +
                '<option value="iPhone 15 Pro Max">iPhone 15 Pro Max</option>' +
                '<option value="iPhone 15 Pro / 15">iPhone 15 / 15 Pro</option>' +
                '<option value="iPhone 14 / 14 Pro Max">iPhone 14 / 14 Pro Max</option>' +
                '<option value="iPhone 13 / 13 Pro Max">iPhone 13 / 13 Pro Max</option>' +
                '<option value="iPhone 11 / 12">iPhone 11 / 12</option>' +
              '</optgroup>' +
              '<optgroup label="Samsung Galaxy">' +
                '<option value="Samsung Galaxy S26 Ultra">Samsung Galaxy S26 Ultra</option>' +
                '<option value="Samsung Galaxy S25 Ultra">Samsung Galaxy S25 Ultra</option>' +
                '<option value="Samsung Galaxy S25 FE">Samsung Galaxy S25 FE</option>' +
                '<option value="Samsung Galaxy S24 Ultra">Samsung Galaxy S24 Ultra</option>' +
                '<option value="Samsung Galaxy S23 Ultra">Samsung Galaxy S23 Ultra</option>' +
                '<option value="Samsung Galaxy A55 5G">Samsung Galaxy A55 5G</option>' +
                '<option value="Samsung Galaxy A35 / A25">Samsung Galaxy A35 / A25</option>' +
                '<option value="Samsung Galaxy A15 / A07">Samsung Galaxy A15 / A07</option>' +
                '<option value="Samsung Galaxy A06 / A05s">Samsung Galaxy A06 / A05s</option>' +
              '</optgroup>' +
              '<optgroup label="Xiaomi / Redmi / POCO">' +
                '<option value="Redmi Note 15 Pro">Redmi Note 15 Pro</option>' +
                '<option value="Redmi 15C">Redmi 15C</option>' +
                '<option value="Redmi Note 13 Pro+ / Pro">Redmi Note 13 Pro+ / Pro</option>' +
                '<option value="Redmi 13C">Redmi 13C</option>' +
                '<option value="POCO X6 Pro / F6">POCO X6 Pro / F6</option>' +
                '<option value="Xiaomi 14 Ultra / 14">Xiaomi 14 Ultra / 14</option>' +
              '</optgroup>' +
              '<optgroup label="Otras Marcas Compatibles">' +
                '<option value="Motorola Moto G85 / Edge 50">Motorola Moto G85 / Edge 50</option>' +
                '<option value="Honor 200 / Magic 6 Lite">Honor 200 / Magic 6 Lite</option>' +
                '<option value="Infinix Note 40 / Hot 40">Infinix Note 40 / Hot 40</option>' +
                '<option value="Vivo V60 Lite / V40">Vivo V60 Lite / V40</option>' +
                '<option value="Otro modelo de celular">Otro modelo (indicar en notas)</option>' +
              '</optgroup>' +
            '</select>' +
          '</div>';
      }

      content.innerHTML =
        '<div class="tp-cat-card-top" style="margin-bottom: 16px; padding-right: 36px;">' +
          '<div style="display: flex; align-items: center; gap: 6px;">' +
            '<span class="tp-cat-card-category">' + item.category + '</span>' +
            badgeHtml +
          '</div>' +
          '<span class="tp-cat-card-code">Cód: ' + item.code + '</span>' +
        '</div>' +
        '<div class="tp-modal-img" style="display: flex; flex-direction: column; align-items: center;">' +
          '<img id="tp-modal-main-img" src="' + imgUrl + '" alt="' + item.name + '" style="max-height: 280px; object-fit: contain;">' +
          thumbsHtml +
        '</div>' +
        '<h2 style="font-size: 21px; font-weight: 800; margin: 14px 0 10px; line-height: 1.3; color: #111;">' + item.name + '</h2>' +
        '<div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px;">' +
          '<div style="font-size: 26px; font-weight: 900; color: #111;" id="tp-modal-total-display">' + formatCop(item.price) + '</div>' +
          (item.stock > 0 ? '<span class="tp-stock-tag"><span class="tp-stock-dot"></span>' + item.stock + ' disponibles</span>' : '') +
        '</div>' +

        // Selector de Cantidad para TODOS los productos
        '<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; background: #f8f9fa; padding: 12px 16px; border-radius: 14px; border: 1px solid #e8e8ea;">' +
          '<div>' +
            '<div style="font-size: 13px; font-weight: 800; color: #111;">Cantidad a comprar</div>' +
            '<div style="font-size: 11px; color: #6b7280;">' + (item.stock > 0 ? 'Hasta ' + item.stock + ' unidades disponibles' : 'Entrega garantizada') + '</div>' +
          '</div>' +
          '<div style="display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid #d1d5db; border-radius: 10px; background: #fff; padding: 2px;">' +
            '<button type="button" onclick="window.adjustModalQty(-1)" style="width: 32px; height: 32px; border: none; background: #f3f4f6; border-radius: 8px; font-size: 16px; font-weight: 900; cursor: pointer; display: flex; align-items: center; justify-content: center;">-</button>' +
            '<span id="tp-modal-qty-val" style="font-size: 14px; font-weight: 900; min-width: 28px; text-align: center;">1</span>' +
            '<button type="button" onclick="window.adjustModalQty(1)" style="width: 32px; height: 32px; border: none; background: #f3f4f6; border-radius: 8px; font-size: 16px; font-weight: 900; cursor: pointer; display: flex; align-items: center; justify-content: center;">+</button>' +
          '</div>' +
        '</div>' +

        glassSelectionHtml +
        glassModelHtml +

        '<div style="background: #f8f9fa; border-radius: 14px; padding: 14px 16px; margin-bottom: 22px; border: 1px solid #e8e8ea; max-height: 200px; overflow-y: auto;">' +
          '<div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #70757d; margin-bottom: 8px;">Descripción y Especificaciones</div>' +
          '<p style="font-size: 13px; color: #4b5563; line-height: 1.6; margin: 0;">' + formattedDesc + '</p>' +
        '</div>' +

        '<div style="display: flex; flex-direction: column; gap: 8px; width: 100%;">' +
          '<button type="button" class="tp-cat-card-btn" style="text-align: center; justify-content: center; font-size: 14.5px; padding: 14px 24px; text-decoration: none; background: #e02424; cursor: pointer; border: none; width: 100%; border-radius: 12px;" onclick="window.proceedModalAddToCart(true)">' +
            '<span id="tp-modal-btn-label">🛒 Añadir al carrito • ' + formatCop(item.price) + '</span>' +
            '<span style="margin-left: 8px;">+</span>' +
          '</button>' +
          '<button type="button" style="text-align: center; justify-content: center; font-size: 13px; font-weight: 700; padding: 10px 18px; color: #4b5563; background: #f3f4f6; border: 1px solid #e5e7eb; cursor: pointer; border-radius: 10px;" onclick="window.closeModal()">' +
            '← Seguir viendo más productos' +
          '</button>' +
        '</div>';

      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      refreshModalPriceDisplay();
    };

    window.closeModal = function(e) {
      if (e && e.target && e.target !== e.currentTarget && e.target.className !== "tp-modal-close") {
        return;
      }
      var modal = document.getElementById("tp-product-modal");
      if (modal) modal.style.display = "none";
      document.body.style.overflow = "";
    };

    // Parse URL search query (e.g. ?categoria=Celulares or ?q=cargador)
    var urlParams = new URLSearchParams(window.location.search);
    var urlCat = urlParams.get("categoria") || urlParams.get("category");
    var urlQ = urlParams.get("q") || urlParams.get("search");

    if (urlCat) {
      currentCategory = urlCat;
    }
    if (urlQ) {
      currentSearch = urlQ;
      var inp = document.getElementById("cat-search-input");
      if (inp) inp.value = urlQ;
      var clearBtn = document.getElementById("cat-search-clear");
      if (clearBtn) clearBtn.style.display = "flex";
    }

    // Load inventory JSON
    fetch("{{ 'inventarioCompleto.json' | asset_url }}")
      .then(function(res) {
        if (!res.ok) throw new Error("HTTP error " + res.status);
        return res.json();
      })
      .then(function(data) {
        rawItems = data;
        renderTabs();
        renderProducts();
      })
      .catch(function(err) {
        console.error("Error loading inventory", err);
        var grid = document.getElementById("cat-products-grid");
        if (grid) {
          grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #e02424;">' +
            '<p style="font-weight: 700;">Error al cargar el inventario. Por favor recarga la página.</p>' +
            '</div>';
        }
      });
  })();
</script>

<script type="importmap">
{
  "imports": {
    "three": "https://esm.sh/three@0.170.0",
    "three/": "https://esm.sh/three@0.170.0/",
    "three/addons/": "https://esm.sh/three@0.170.0/examples/jsm/"
  }
}
</script>

<script type="module">
  import * as THREE from 'https://esm.sh/three@0.170.0';
  import { GLTFLoader } from 'https://esm.sh/three@0.170.0/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'https://esm.sh/three@0.170.0/examples/jsm/loaders/DRACOLoader.js';

  (function() {
    var container = document.getElementById('tp-3d-canvas-wrap');
    if (!container) return;

    var loaderEl = document.getElementById('tp-3d-loader');
    var indicatorsEl = document.getElementById('tp-3d-indicators');

    function hideLoader() {
      if (loaderEl && loaderEl.style.display !== 'none') {
        loaderEl.style.opacity = '0';
        setTimeout(function() {
          if (loaderEl) loaderEl.style.display = 'none';
        }, 400);
      }
    }

    // Safety timeout: never leave user stuck waiting
    setTimeout(hideLoader, 3500);

    function isWebGLSupported() {
      try {
        var canvas = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (canvas.getContext('webgl') || canvas.getContext('experimental-webgl')));
      } catch(e) {
        return false;
      }
    }

    if (!isWebGLSupported()) {
      hideLoader();
      return;
    }

    var MODELS = [
      {
        name: "iPhone 17 Pro Max",
        tag: "Titanio",
        url: "https://cdn.shopify.com/3d/models/7e6a34dc470913bd/apple_iphone_17_pro_max-v1.glb",
        targetScale: 1.95
      },
      {
        name: "iPhone Duo Fold 2026",
        tag: "Star White",
        url: "https://cdn.shopify.com/3d/models/b55d3b4df3dff883/apple_iphone_duo_fold_star_white_2026_animated-v1.glb",
        targetScale: 1.85
      },
      {
        name: "iPhone 18 Pro Max",
        tag: "Next-Gen 2026",
        url: "https://cdn.shopify.com/3d/models/585bfd95ec79a6b3/phone18-v1.glb",
        targetScale: 1.95
      }
    ];

    MODELS.forEach(function(m) {
      if (m.url && m.url.indexOf('//') === 0) {
        m.url = 'https:' + m.url;
      }
    });

    var scene = new THREE.Scene();
    var width = container.clientWidth || 320;
    var height = container.clientHeight || 280;

    var camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
    camera.position.set(0, 0, 3.2);

    var renderer;
    try {
      renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: "high-performance"
      });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.35;
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      container.appendChild(renderer.domElement);
    } catch(err) {
      console.warn("WebGL renderer creation failed", err);
      hideLoader();
      return;
    }

    // Studio Lights
    var ambientLight = new THREE.AmbientLight(0xffffff, 1.4);
    scene.add(ambientLight);

    var keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(4, 5, 4);
    scene.add(keyLight);

    var fillLight = new THREE.DirectionalLight(0xf0f4f8, 1.8);
    fillLight.position.set(-4, 2, 3);
    scene.add(fillLight);

    var rimLight = new THREE.DirectionalLight(0xffffff, 2.2);
    rimLight.position.set(0, 4, -4);
    scene.add(rimLight);

    var redAccentLight = new THREE.PointLight(0xe02424, 2.2, 10);
    redAccentLight.position.set(2, -2, 1);
    scene.add(redAccentLight);

    // Slots & Pivots
    var slots = MODELS.map(function(_, i) {
      var pivot = new THREE.Group();
      pivot.position.x = i === 0 ? 0 : 4.5;
      pivot.visible = i === 0;
      pivot.rotation.x = 0.12;
      pivot.rotation.z = -0.04;
      scene.add(pivot);
      return {
        pivot: pivot,
        mixer: null,
        loaded: false
      };
    });

    var currentModelIndex = 0;
    var activeModelIndex = 0;

    // Loaders
    var dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath("https://www.gstatic.com/draco/versioned/decoders/1.5.7/");
    dracoLoader.preload();

    var gltfLoader = new GLTFLoader();
    gltfLoader.setDRACOLoader(dracoLoader);

    function setupModel(gltf, idx, cfg) {
      var model = gltf.scene;
      var box = new THREE.Box3().setFromObject(model);
      var center = box.getCenter(new THREE.Vector3());
      var size = box.getSize(new THREE.Vector3());
      var maxDim = Math.max(size.x, size.y, size.z);

      var scale = cfg.targetScale / (maxDim || 1);
      model.scale.set(scale, scale, scale);
      model.position.set(-center.x * scale, -center.y * scale, -center.z * scale);

      model.traverse(function(child) {
        if (child.isMesh && child.material) {
          var mats = Array.isArray(child.material) ? child.material : [child.material];
          mats.forEach(function(m) {
            if ("envMapIntensity" in m) m.envMapIntensity = 1.25;
            m.needsUpdate = true;
          });
        }
      });

      if (gltf.animations && gltf.animations.length > 0) {
        var mixer = new THREE.AnimationMixer(model);
        var action = mixer.clipAction(gltf.animations[0]);
        action.setLoop(THREE.LoopPingPong, Infinity);
        action.play();
        slots[idx].mixer = mixer;
      }

      slots[idx].pivot.add(model);
      slots[idx].loaded = true;

      // Hide loader once the initial or current model is ready
      if (idx === 0 || idx === currentModelIndex) {
        hideLoader();
      }
    }

    MODELS.forEach(function(cfg, idx) {
      gltfLoader.load(
        cfg.url,
        function(gltf) { setupModel(gltf, idx, cfg); },
        undefined,
        function(err) {
          console.warn("Error loading 3D model " + cfg.name, err);
          hideLoader();
        }
      );
    });

    // Render indicators
    function renderIndicators() {
      if (!indicatorsEl) return;
      indicatorsEl.innerHTML = '';
      MODELS.forEach(function(cfg, idx) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tp-3d-nav-btn' + (idx === activeModelIndex ? ' active' : '');
        btn.title = cfg.name;
        btn.innerHTML = '<span class="tp-3d-pill"></span>' + (idx === activeModelIndex ? '<span class="tp-3d-nav-label">' + cfg.name + '</span>' : '');
        btn.onclick = function() {
          startTransition(idx);
          resetInterval();
        };
        indicatorsEl.appendChild(btn);
      });
    }

    renderIndicators();

    // Transitions
    var transitionProgress = 1;
    var isTransitioning = false;
    var outgoingIndex = 0;
    var incomingIndex = 0;

    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function startTransition(toIndex) {
      if (toIndex === currentModelIndex) return;

      if (isTransitioning) {
        slots[incomingIndex].pivot.position.x = 0;
        slots[incomingIndex].pivot.scale.set(1, 1, 1);
        slots[outgoingIndex].pivot.position.x = -4.0;
        slots[outgoingIndex].pivot.visible = false;
      }

      isTransitioning = true;
      transitionProgress = 0;
      outgoingIndex = currentModelIndex;
      incomingIndex = toIndex;
      currentModelIndex = toIndex;
      activeModelIndex = toIndex;
      renderIndicators();

      slots[incomingIndex].pivot.position.x = 4.0;
      slots[incomingIndex].pivot.scale.set(0.75, 0.75, 0.75);
      slots[incomingIndex].pivot.visible = true;
    }

    var intervalId = null;
    function resetInterval() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(function() {
        var next = (currentModelIndex + 1) % MODELS.length;
        startTransition(next);
      }, 7000);
    }
    resetInterval();

    // User drag rotation interaction
    var isDragging = false;
    var prevMouseX = 0;
    container.addEventListener('mousedown', function(e) {
      isDragging = true;
      prevMouseX = e.clientX;
    });
    window.addEventListener('mouseup', function() { isDragging = false; });
    window.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      var deltaX = e.clientX - prevMouseX;
      prevMouseX = e.clientX;
      if (slots[currentModelIndex]) {
        slots[currentModelIndex].pivot.rotation.y += deltaX * 0.015;
      }
    });

    // Touch support
    container.addEventListener('touchstart', function(e) {
      if (e.touches && e.touches[0]) {
        isDragging = true;
        prevMouseX = e.touches[0].clientX;
      }
    }, { passive: true });
    window.addEventListener('touchend', function() { isDragging = false; });
    window.addEventListener('touchmove', function(e) {
      if (!isDragging || !e.touches || !e.touches[0]) return;
      var deltaX = e.touches[0].clientX - prevMouseX;
      prevMouseX = e.touches[0].clientX;
      if (slots[currentModelIndex]) {
        slots[currentModelIndex].pivot.rotation.y += deltaX * 0.015;
      }
    }, { passive: true });

    // Animation Loop
    var lastTime = performance.now();
    function animate() {
      requestAnimationFrame(animate);
      var now = performance.now();
      var delta = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      slots.forEach(function(slot) {
        if (slot.mixer) slot.mixer.update(delta);
      });

      if (isTransitioning) {
        transitionProgress += delta * 1.1;
        if (transitionProgress >= 1) {
          transitionProgress = 1;
          isTransitioning = false;
          slots[incomingIndex].pivot.position.x = 0;
          slots[incomingIndex].pivot.scale.set(1, 1, 1);
          slots[outgoingIndex].pivot.position.x = -4.0;
          slots[outgoingIndex].pivot.visible = false;
        } else {
          var eased = easeInOutCubic(transitionProgress);
          slots[outgoingIndex].pivot.position.x = THREE.MathUtils.lerp(0, -4.0, eased);
          var outScale = THREE.MathUtils.lerp(1, 0.75, eased);
          slots[outgoingIndex].pivot.scale.set(outScale, outScale, outScale);

          slots[incomingIndex].pivot.position.x = THREE.MathUtils.lerp(4.0, 0, eased);
          var inScale = THREE.MathUtils.lerp(0.75, 1, eased);
          slots[incomingIndex].pivot.scale.set(inScale, inScale, inScale);
        }
      }

      // Continuous rotation on its own axis (if not dragging)
      if (!isDragging) {
        slots.forEach(function(slot, i) {
          if (slot.pivot.visible || i === currentModelIndex) {
            slot.pivot.rotation.y += 0.009;
          }
        });
      }

      renderer.render(scene, camera);
    }
    animate();

    // Resize
    function onResize() {
      if (!container || !renderer || !camera) return;
      var w = container.clientWidth;
      var h = container.clientHeight;
      if (!w || !h) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    window.addEventListener('resize', onResize);
  })();
</script>


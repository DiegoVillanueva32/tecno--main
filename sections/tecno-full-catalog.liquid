    function resolveSingleUrl(str) {
      if (!str) return "";
      if (str.indexOf("http://") === 0 || str.indexOf("https://") === 0 || str.indexOf("//") === 0) {
        return str;
      }
      var clean = str.split("?")[0];
      var rawFilename = clean.split("/").pop();
      if (!rawFilename) return "";
      if (ASSET_MAP[rawFilename]) return ASSET_MAP[rawFilename];
      try {
        var decoded = decodeURIComponent(rawFilename);
        if (ASSET_MAP[decoded]) return ASSET_MAP[decoded];
      } catch(e) {}
      return "";
    }

    function resolveItemImage(item) {

<script>
  (function() {
    var rawItems = [];
    var categories = [
      "Todos",
      "Celulares",
      "Combos",
      "Sonido y Audio",
      "Audifonos y Diademas",
      "Gaming y TV Box",
      "Smartwatch y Relojes",
      "Cargadores y Energía",
      "Cables y Conectividad",
      "Cómputo y Accesorios",
      "POS y Oficina",
      "Accesorios y Varios"
    ];

    var currentCategory = "Todos";
    var currentSearch = "";
    var currentSort = "featured";
    var pageSize = 24;
    var visibleLimit = pageSize;

    function normalizeText(text) {
      if (!text) return "";
      return text
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9\s]/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function tokenizeQuery(query) {
      var norm = normalizeText(query);
      if (!norm) return [];
      return norm.split(" ").filter(function(t) { return t.length > 0; });
    }

    function matchCategory(itemCat, targetCat) {
      if (targetCat === "Todos") return true;
      var n1 = normalizeText(itemCat);
      var n2 = normalizeText(targetCat);
      return n1 === n2;
    }

    var defaultFallbackImg = "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/smartwatch.jpg?v=1791928273";

    function formatCop(num) {
      if (!num) return "$ 0";

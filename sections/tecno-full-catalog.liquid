{%- comment -%}
  Tecno+ Catálogo Completo (589+ items, Search, Filters, Sorting & Quick View Modal)
{%- endcomment -%}

<section class="tp-catalog-page" id="catalogo-completo">
  <div class="tp-container">
    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="tp-catalog-breadcrumb" aria-label="Ruta de navegación">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span class="tp-breadcrumb-sep">/</span>
      <b>Catálogo Completo</b>
    </nav>

    {%- comment -%} Hero Banner {%- endcomment -%}
    <div class="tp-catalog-hero">
      <div class="tp-catalog-hero-text">
        <span class="tp-badge-official">INVENTARIO OFICIAL 2026</span>
        <h1>Catálogo</h1>
        <p>
          Explora más de 500 referencias de celulares, audio, gaming, cómputo y accesorios con precios oficiales actualizados. Compra online rápida y 100% segura con tarjeta o PSE.
        </p>
      </div>

      <div class="tp-catalog-hero-preview">
        <div id="tp-hero-3d-box" class="tp-catalog-3d-box">
          <div id="tp-3d-canvas-wrap"></div>
          
          <div id="tp-3d-loader">
            <div class="tp-3d-spinner"></div>
            <span>Cargando modelos 3D...</span>
          </div>

          <div id="tp-3d-indicators"></div>
        </div>
      </div>

      <div class="tp-hero-glow-red"></div>
      <div class="tp-hero-glow-white"></div>
    </div>

    {%- comment -%} Search & Sort Bar {%- endcomment -%}
    <div class="tp-catalog-controls">
      <div class="tp-search-input-wrap">
        <svg class="tp-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="cat-search-input"
          placeholder="Buscar por nombre (ej. Diadema, Parlante, Cargador...) o código..."
          oninput="onSearchInput(this.value)"
        >
        <button type="button" id="cat-search-clear" onclick="clearSearch()" style="display: none;">✕</button>
      </div>

      <div class="tp-sort-wrap">
        <label for="cat-sort-select">Ordenar:</label>
        <select id="cat-sort-select" onchange="onSortChange(this.value)">
          <option value="featured">Destacados</option>
          <option value="price-asc">Menor precio</option>
          <option value="price-desc">Mayor precio</option>
          <option value="name">Nombre (A - Z)</option>
        </select>
      </div>
    </div>

    {%- comment -%} Category Pills Tabs {%- endcomment -%}
    <div class="tp-category-tabs" id="cat-tabs-bar">
      {%- comment -%} Injected dynamically by JS {%- endcomment -%}
    </div>

    {%- comment -%} Results Count Header {%- endcomment -%}
    <div class="tp-catalog-results-bar">
      <span id="cat-count-text">Cargando catálogo oficial...</span>
      <span class="tp-catalog-currency-hint">Precios en pesos colombianos (COP)</span>
    </div>

    {%- comment -%} Products Grid {%- endcomment -%}
    <div class="tp-catalog-grid" id="cat-products-grid">
      {%- comment -%} Rendered dynamically by JS {%- endcomment -%}
    </div>

    {%- comment -%} Load More CTA {%- endcomment -%}
    <div class="tp-load-more-wrap" id="cat-load-more-wrap" style="display: none;">
      <button type="button" class="tp-load-more-btn" onclick="loadMoreProducts()">
        <span id="cat-load-more-text">Cargar más productos (+24)</span>
        <span>↓</span>
      </button>
    </div>
  </div>
</section>

{%- comment -%} Quick View Modal {%- endcomment -%}
<div id="tp-product-modal" class="tp-modal-overlay" style="display: none;" onclick="closeModal(event)">
  <div class="tp-modal-box" onclick="event.stopPropagation()">
    <button type="button" class="tp-modal-close" onclick="closeModal()" aria-label="Cerrar modal">✕</button>
    <div class="tp-modal-content" id="modal-content">
      {%- comment -%} Injected dynamically by JS {%- endcomment -%}
    </div>
  </div>
</div>


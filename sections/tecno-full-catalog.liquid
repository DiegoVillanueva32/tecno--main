      if (code === "9139" || item.id === "vidrios-antiespia-9139" || nameUpper.indexOf("VIDRIOS ANTIESPIA") !== -1 || nameUpper.indexOf("VIDRIOS ANTIESPÍA") !== -1) {
        return "https://cdn.shopify.com/s/files/1/0667/5903/2972/files/vidrio-antiespia-celular.jpg?v=1791928273";
      }

      var direct = resolveSingleUrl(item.image);
      if (direct) return direct;

      if (item.images && item.images.length > 0) {
        for (var i = 0; i < item.images.length; i++) {
          var matched = resolveSingleUrl(item.images[i]);
          if (matched) return matched;
        }
      }

      return getFallback(item.category, item.name);
    }

    function renderTabs() {
      var tabsContainer = document.getElementById("cat-tabs-bar");
      if (!tabsContainer) return;
      tabsContainer.innerHTML = "";

      categories.forEach(function(cat) {
        var count = 0;
        if (cat === "Todos") {
          count = rawItems.length;
        } else {
          count = rawItems.filter(function(i) { return matchCategory(i.category, cat); }).length;
        }

        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "tp-cat-tab" + (cat === currentCategory ? " active" : "");
        btn.innerHTML = '<span>' + cat + '</span><span class="tp-cat-tab-badge">' + count + '</span>';
        btn.onclick = function() {
          currentCategory = cat;
          visibleLimit = pageSize;
          renderTabs();
          renderProducts();
        };
        tabsContainer.appendChild(btn);
      });
    }

    function filterAndSort() {
      var tokens = tokenizeQuery(currentSearch);
      var filtered = rawItems.filter(function(item) {
        // Filter by category
        if (currentCategory !== "Todos" && !matchCategory(item.category, currentCategory)) {
          return false;
        }
        // Filter by search tokens
        if (tokens.length > 0) {
          var haystack = normalizeText(
            (item.name || "") + " " + (item.code || "") + " " + (item.category || "") + " " + (item.description || "")
          );
          for (var i = 0; i < tokens.length; i++) {
            if (haystack.indexOf(tokens[i]) === -1) {
              return false;
            }
          }
        }
        return true;
      });

      // Sort
      if (currentSort === "price-asc") {
        filtered.sort(function(a, b) { return a.price - b.price; });
      } else if (currentSort === "price-desc") {
        filtered.sort(function(a, b) { return b.price - a.price; });
      } else if (currentSort === "name") {
        filtered.sort(function(a, b) { return (a.name || "").localeCompare(b.name || ""); });
      }

      return filtered;
    }

    function renderProducts() {
      var grid = document.getElementById("cat-products-grid");
      var countText = document.getElementById("cat-count-text");
      var loadMoreWrap = document.getElementById("cat-load-more-wrap");
      var loadMoreText = document.getElementById("cat-load-more-text");
      if (!grid) return;

      var filtered = filterAndSort();
      var visible = filtered.slice(0, visibleLimit);

      if (countText) {
        countText.innerHTML = "Mostrando <b>" + visible.length + "</b> de <b>" + filtered.length + "</b> productos" +
          (currentCategory !== "Todos" ? " en <b>" + currentCategory + "</b>" : "");
      }

      grid.innerHTML = "";
      if (visible.length === 0) {
        grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #ffffff; border-radius: 20px; border: 1px solid #e8e8ea;">' +
          '<div style="font-size: 38px; margin-bottom: 10px;">🔍</div>' +
          '<p style="font-size: 18px; font-weight: 800; color: #111; margin: 0 0 6px;">No se encontraron productos</p>' +
          '<p style="font-size: 14px; color: #70757d; margin: 0 0 16px;">Intenta buscar con otra palabra clave o restablece los filtros.</p>' +
          '<button type="button" onclick="clearSearch()" style="border-radius: 999px; background: #111; color: #fff; border: none; padding: 9px 22px; font-weight: 700; cursor: pointer;">Restablecer filtros</button>' +
          '</div>';
        if (loadMoreWrap) loadMoreWrap.style.display = "none";
        return;
      }

      visible.forEach(function(item) {
        var card = document.createElement("div");
        card.className = "tp-cat-card";

        var imgUrl = resolveItemImage(item);

        var badgeHtml = item.badge ? '<span class="tp-card-badge">' + item.badge + '</span>' : '';
        var stockHtml = item.stock > 0 ? '<span class="tp-stock-tag"><span class="tp-stock-dot"></span>' + item.stock + ' disponibles</span>' : '';
        var btnText = item.badge === "Preventa" ? "Apartar Preventa" : "Añadir al carrito";

        card.innerHTML =
          '<div>' +
            '<div class="tp-cat-card-top">' +
              '<span class="tp-cat-card-category">' + (item.category || "General") + '</span>' +
              '<span class="tp-cat-card-code">Cód: ' + (item.code || item.id) + '</span>' +
            '</div>' +
            '<div class="tp-cat-card-img-wrap">' +
              badgeHtml +
              '<img src="' + imgUrl + '" alt="' + item.name + '" loading="lazy" onerror="this.src=\'' + defaultFallbackImg + '\'">' +
            '</div>' +
            '<h3>' + item.name + '</h3>' +
            '<div class="tp-cat-card-hint"><span>👁️</span><span>Toca para ver descripción completa</span></div>' +
          '</div>' +
          '<div class="tp-cat-card-bottom">' +
            '<div class="tp-price-row">' +
              '<div>' +
                '<span class="tp-price-label">Precio de venta:</span>' +
                '<div class="tp-cat-card-price">' + formatCop(item.price) + '</div>' +
              '</div>' +
              stockHtml +
            '</div>' +
            '<button type="button" class="tp-cat-card-btn" onclick="event.stopPropagation(); window.handleCatalogItemAdd(this, \'' + (item.id || item.code) + '\')">' +
              '<span>🛒 ' + btnText + '</span>' +
              '<span>+</span>' +
            '</button>' +
          '</div>';

        card.onclick = function() {
          openModal(item, imgUrl);
        };

        grid.appendChild(card);
      });

      if (loadMoreWrap) {
        var remaining = filtered.length - visibleLimit;
        if (remaining > 0) {
          loadMoreWrap.style.display = "flex";
          if (loadMoreText) {
            loadMoreText.textContent = "Cargar más productos (+" + Math.min(pageSize, remaining) + ")";
          }
        } else {
          loadMoreWrap.style.display = "none";
        }
      }
    }

    window.loadMoreProducts = function() {
      visibleLimit += pageSize;
      renderProducts();
    };

    window.onSearchInput = function(val) {
      currentSearch = val;
      visibleLimit = pageSize;
      var clearBtn = document.getElementById("cat-search-clear");
      if (clearBtn) {
        clearBtn.style.display = val ? "flex" : "none";

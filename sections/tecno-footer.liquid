{% stylesheet %}
  .tp-footer-section {
    background: #080808;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    padding: 70px 0 28px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
    border-top: 1px solid #1a1a1a;
  }

  .tp-footer-watermark {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: clamp(60px, 11vw, 150px);
    font-weight: 900;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.035);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    z-index: 1;
  }

  .tp-footer-container {
    position: relative;
    z-index: 10;
  }

  .tp-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.4fr;
    gap: 48px;
    margin-bottom: 50px;
  }

  .tp-footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .tp-footer-logo-text {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 0.5px;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
  }

  .tp-footer-logo-text .tp-logo-plus {
    color: #ffffff;
  }

  .tp-footer-logo-text .tp-logo-o::after {
    background: #ffffff;
  }

  .tp-footer-bio {
    color: #999999;
    font-size: 14px;
    line-height: 1.65;
    max-width: 440px;
    margin: 0 0 24px;
  }

  .tp-footer-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #e02424 0%, #b91c1c 100%);
    color: #ffffff !important;
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none !important;
    box-shadow: 0 4px 18px rgba(224, 36, 36, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    width: fit-content;
    margin-bottom: 24px;
  }

  .tp-footer-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(224, 36, 36, 0.5);
  }

  .tp-footer-socials {
    display: flex;
    gap: 12px;
  }

  .tp-social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #181818;
    border: 1px solid #282828;
    color: #cccccc !important;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none !important;
    transition: all 0.2s;
  }

  .tp-social-icon:hover {
    background: #e02424;
    border-color: #e02424;
    color: #ffffff !important;
    transform: translateY(-2px);
  }

  .tp-footer-col h4 {
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  .tp-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tp-footer-links li {
    margin-bottom: 12px;
  }

  .tp-footer-links a {
    color: #999999 !important;
    font-size: 14px;
    text-decoration: none !important;
    transition: color 0.2s, padding-left 0.2s;
    display: inline-block;
  }

  .tp-footer-links a:hover {
    color: #e02424 !important;
    padding-left: 4px;
  }

  .tp-footer-contact {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tp-footer-contact li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #999999;
    font-size: 14px;
    margin-bottom: 14px;
  }

  .tp-footer-contact svg {
    color: #e02424;
    flex-shrink: 0;
  }

  .tp-footer-bottom {
    border-top: 1px solid #1a1a1a;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #777777;
    font-size: 13px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tp-footer-bottom p {
    margin: 0;
  }

  .tp-footer-trust-notes {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .tp-footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .tp-footer-watermark {
      display: none;
    }
  }
{% endstylesheet %}


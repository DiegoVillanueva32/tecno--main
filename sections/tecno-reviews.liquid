{%- comment -%}
  Tecno+ Customer Reviews Section (Lo que dicen nuestros clientes)
  - Conectado a Supabase en vivo (público para todos los visitantes)
  - Permite comentar, calificar, subir foto de perfil real, dar like y borrar únicamente su propia reseña.
{%- endcomment -%}

<section id="opiniones" class="tp-section tp-reviews-section">
  <div class="tp-container">
    <div class="tp-reviews-head">
      <span class="tp-verified-badge">
        <span class="tp-verified-dot"></span>
        <span id="rev-total-verified">86 Opiniones Verificadas en Colombia</span>
      </span>
      <h2>{{ section.settings.title | default: 'Lo que dicen nuestros clientes' }}</h2>
      <p>
        {{ section.settings.description | default: 'Experiencias reales de compradores en Montería y toda Colombia. Haz clic en cualquier tarjeta para enfocarla.' }}
      </p>

      {%- comment -%} Filter Pills & New Review Button {%- endcomment -%}
      <div class="tp-reviews-filters">
        <button
          type="button"
          class="tp-filter-pill tp-filter-btn"
          onclick="openNewReviewModal()"
          id="tp-btn-dejar-opinion"
        >
          ✏️ Dejar mi opinión (0 a 5★)
        </button>
        <button type="button" class="tp-filter-pill active" id="pill-all" onclick="filterReviewsCategory('all')">
          Todas (<span id="count-pill-all">86</span>)
        </button>
        <button type="button" class="tp-filter-pill" id="pill-5" onclick="filterReviewsCategory('5')">
          5 ★ (<span id="count-pill-5">78</span>)
        </button>
        <button type="button" class="tp-filter-pill" id="pill-4" onclick="filterReviewsCategory('4')">
          4 ★ (<span id="count-pill-4">8</span>)
        </button>
      </div>
    </div>

    {%- comment -%} Carousel Container {%- endcomment -%}
    <div class="tp-carousel-wrapper" id="reviews-carousel-{{ section.id }}">
      <div class="tp-reviews-stage" id="tp-dynamic-reviews-stage">
        {%- comment -%} Loading placeholder spinner {%- endcomment -%}
        <div style="text-align: center; padding: 40px 0; color: #6b7280; font-size: 14px; font-weight: 600;">
          <div class="tp-rev-spinner" style="margin: 0 auto 12px;"></div>
          Cargando opiniones de clientes verificados...
        </div>
      </div>

      {%- comment -%} Carousel Controls {%- endcomment -%}
      <div class="tp-reviews-controls">
        <button type="button" class="tp-rev-btn" onclick="prevReview()" aria-label="Anterior">‹</button>
        <span class="tp-auto-indicator">
          <span class="tp-dot-green">●</span> Rotando auto
        </span>
        <span class="tp-rev-counter" id="rev-counter">1 / 86</span>
        <button type="button" class="tp-rev-btn" onclick="nextReview()" aria-label="Siguiente">›</button>
      </div>
    </div>
  </div>
</section>

<style>
  #tp-new-review-modal.tp-modal-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.72) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 2147483647 !important;
    display: none;
    align-items: center !important;
    justify-content: center !important;
    padding: 16px !important;
    box-sizing: border-box !important;
  }
  #tp-new-review-modal .tp-modal-container {
    width: 100% !important;
    max-width: 520px !important;
    background: #ffffff !important;
    color: #111111 !important;
    border-radius: 24px !important;
    padding: 26px !important;
    max-height: 90vh !important;
    overflow-y: auto !important;
    position: relative !important;
    box-shadow: 0 25px 60px -12px rgba(0,0,0,0.45) !important;
    animation: tpModalFadeIn 0.25s ease-out !important;
  }
  @keyframes tpModalFadeIn {
    from { opacity: 0; transform: scale(0.95) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>

{%- comment -%} Modal Para Dejar Nueva Opinión {%- endcomment -%}
<div id="tp-new-review-modal" class="tp-modal-overlay" style="display: none;" onclick="if(event.target===this) window.closeNewReviewModal()">
  <div class="tp-modal-container">
    <button type="button" onclick="window.closeNewReviewModal()" style="position: absolute; right: 18px; top: 18px; background: #f3f4f6; border: none; width: 32px; height: 32px; border-radius: 50%; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: 700;">✕</button>

    <div style="text-align: center; margin-bottom: 20px;">
      <span style="font-size: 32px; display: block; margin-bottom: 6px;">⭐</span>
      <h3 style="font-size: 22px; font-weight: 900; margin: 0; color: #111;">Comparte tu experiencia en Tecno+</h3>
      <p style="font-size: 13px; color: #6b7280; margin: 6px 0 0;">Tu opinión quedará visible públicamente para toda la comunidad.</p>
    </div>

    <form id="tp-new-review-form" onsubmit="handleReviewSubmit(event)">
      <div id="tp-rev-form-error" style="display: none; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; padding: 10px 14px; border-radius: 12px; font-size: 12px; font-weight: 700; margin-bottom: 14px;"></div>

      {%- comment -%} Selector de Estrellas {%- endcomment -%}
      <div style="margin-bottom: 16px; text-align: center; background: #f9fafb; padding: 12px; border-radius: 16px; border: 1px solid #e5e7eb;">
        <label style="display: block; font-size: 11px; font-weight: 800; color: #4b5563; text-transform: uppercase; margin-bottom: 6px;">Calificación General</label>
        <div id="tp-star-picker" style="display: inline-flex; gap: 8px; font-size: 30px; cursor: pointer;">
          <span data-star="1" onclick="selectRating(1)">★</span>
          <span data-star="2" onclick="selectRating(2)">★</span>
          <span data-star="3" onclick="selectRating(3)">★</span>
          <span data-star="4" onclick="selectRating(4)">★</span>
          <span data-star="5" onclick="selectRating(5)">★</span>
        </div>
        <div id="tp-rating-text" style="font-size: 12px; font-weight: 700; color: #111; margin-top: 4px;">5 estrellas - ¡Excelente servicio!</div>
        <input type="hidden" id="tp-rev-rating" value="5">
      </div>

      {%- comment -%} Foto de Perfil {%- endcomment -%}
      <div style="margin-bottom: 16px; background: #f9fafb; padding: 14px; border-radius: 16px; border: 1px solid #e5e7eb;">
        <label style="display: block; font-size: 11px; font-weight: 800; color: #4b5563; text-transform: uppercase; margin-bottom: 8px;">Foto de Perfil (Opcional)</label>
        <div style="display: flex; align-items: center; gap: 14px;">
          <div id="tp-avatar-preview-box" style="width: 52px; height: 52px; border-radius: 50%; background: #e5e7eb; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid #d1d5db; flex-shrink: 0;">
            <span id="tp-avatar-placeholder-icon" style="font-size: 22px;">👤</span>
            <img id="tp-avatar-preview-img" src="" alt="Vista previa" style="display: none; width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div>
            <button type="button" onclick="document.getElementById('tp-rev-photo-input').click()" style="background: #ffffff; border: 1.5px solid #d1d5db; padding: 7px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; color: #111; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
              <span>📸 Subir mi foto</span>
            </button>
            <button type="button" id="tp-remove-photo-btn" onclick="removeSelectedPhoto()" style="display: none; margin-left: 6px; background: none; border: none; font-size: 11px; color: #dc2626; font-weight: 700; cursor: pointer;">✕ Quitar</button>
            <input type="file" id="tp-rev-photo-input" accept="image/*" style="display: none;" onchange="handlePhotoUpload(this)">
            <input type="hidden" id="tp-rev-avatar-data" value="">
            <div style="font-size: 10.5px; color: #6b7280; margin-top: 4px;">Se comprime automáticamente para carga rápida.</div>
          </div>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #4b5563; margin-bottom: 4px;">Nombre completo *</label>
          <input type="text" id="tp-rev-name" required placeholder="Ej. Carlos Mendoza" style="width: 100%; border: 1px solid #d1d5db; border-radius: 12px; padding: 9px 12px; font-size: 13px; outline: none; box-sizing: border-box;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #4b5563; margin-bottom: 4px;">Ciudad / Municipio *</label>
          <input type="text" id="tp-rev-city" required placeholder="Ej. Montería, Córdoba" value="Montería, Córdoba" style="width: 100%; border: 1px solid #d1d5db; border-radius: 12px; padding: 9px 12px; font-size: 13px; outline: none; box-sizing: border-box;">
        </div>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 11px; font-weight: 700; color: #4b5563; margin-bottom: 4px;">¿Qué producto compraste o asesoraste?</label>
        <select id="tp-rev-product" style="width: 100%; border: 1px solid #d1d5db; border-radius: 12px; padding: 9px 12px; font-size: 13px; outline: none; box-sizing: border-box; background: #fff;">
          <option value="Celulares & Tecnología">📱 Celulares & Tecnología</option>
          <option value="iPhone / Apple">🍎 iPhone / Apple</option>
          <option value="Samsung Galaxy">⚡ Samsung Galaxy</option>
          <option value="Xiaomi / Redmi">🔥 Xiaomi / Redmi</option>
          <option value="Combos Especiales">🎁 Combos Especiales</option>
          <option value="Cómputo & Laptops">💻 Cómputo & Laptops</option>
          <option value="Mundo Gamer & Gadgets">🎮 Mundo Gamer & Gadgets</option>
          <option value="Audífonos & Sonido">🎧 Audífonos & Sonido</option>
          <option value="Cargadores & Accesorios">🔌 Cargadores & Accesorios</option>
        </select>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 11px; font-weight: 700; color: #4b5563; margin-bottom: 4px;">Título de tu reseña</label>
        <input type="text" id="tp-rev-title" placeholder="Ej. Excelente servicio y entrega rápida" style="width: 100%; border: 1px solid #d1d5db; border-radius: 12px; padding: 9px 12px; font-size: 13px; outline: none; box-sizing: border-box;">
      </div>

      <div style="margin-bottom: 14px;">
        <label style="display: block; font-size: 11px; font-weight: 700; color: #4b5563; margin-bottom: 4px;">Tu comentario o experiencia * (Mínimo 10 caracteres)</label>
        <textarea id="tp-rev-comment" required rows="3" placeholder="Cuéntanos cómo fue tu experiencia de compra, la atención o el estado del producto..." style="width: 100%; border: 1px solid #d1d5db; border-radius: 12px; padding: 9px 12px; font-size: 13px; outline: none; box-sizing: border-box; resize: vertical;"></textarea>
      </div>

      <div style="margin-bottom: 18px; display: flex; align-items: center; gap: 8px;">
        <input type="checkbox" id="tp-rev-recommended" checked style="width: 16px; height: 16px; accent-color: #059669; cursor: pointer;">
        <label for="tp-rev-recommended" style="font-size: 12.5px; font-weight: 600; color: #374151; cursor: pointer;">Recomiendo comprar en Tecno+</label>
      </div>

      <button type="submit" id="tp-submit-review-btn" style="width: 100%; background: #111111; color: #ffffff; border: none; border-radius: 14px; padding: 13px 20px; font-size: 14px; font-weight: 800; cursor: pointer; transition: background 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px;">
        <span>Publicar mi opinión ahora</span>
        <span>→</span>
      </button>
    </form>
  </div>
</div>

{% stylesheet %}

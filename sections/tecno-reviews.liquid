{% endstylesheet %}

<script>
  (function() {
    var SUPABASE_URL = "https://loytxdzobuqpemjxhnza.supabase.co/rest/v1/reviews";
    var SUPABASE_KEY = "sb_publishable_d6_rrLaq6L4It5JuRavq0g_1L-S8RNQ";

    var allReviews = [];
    var filteredReviews = [];
    var currentIndex = 0;
    var currentFilter = "all";
    var autoRotateInterval = null;

    var AVATAR_COLORS = ["#059669", "#2563eb", "#d97706", "#7c3aed", "#e11d48", "#0891b2"];

    var RATING_DESCRIPTIONS = {
      0: "0 estrellas - Muy insatisfecho",
      1: "1 estrella - Mal servicio",
      2: "2 estrellas - Regular",
      3: "3 estrellas - Bueno",
      4: "4 estrellas - Muy bueno",
      5: "5 estrellas - ¡Excelente servicio!"
    };

    function escapeHtml(str) {
      if (!str) return "";
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function formatTimeAgo(isoString, dateString, id) {
      var ts = isoString || (dateString && !isNaN(Date.parse(dateString)) ? dateString : null);
      if (!ts && id) {
        var match = id.match(/^rev-(\d{13})/);
        if (match) {
          var ms = parseInt(match[1], 10);
          if (!isNaN(ms) && ms > 1600000000000) ts = new Date(ms).toISOString();
        }
      }
      if (ts) {
        var diffSec = Math.max(0, Math.floor((Date.now() - new Date(ts).getTime()) / 1000));
        if (diffSec < 45) return "Hace unos segundos";
        var diffMin = Math.floor(diffSec / 60);
        if (diffMin < 60) return "Hace " + diffMin + " min";
        var diffHours = Math.floor(diffMin / 60);
        if (diffHours < 24) return "Hace " + diffHours + (diffHours === 1 ? " hora" : " horas");
        var diffDays = Math.floor(diffHours / 24);
        if (diffDays < 7) return "Hace " + diffDays + (diffDays === 1 ? " día" : " días");
        var diffWeeks = Math.floor(diffDays / 7);
        if (diffWeeks < 4) return "Hace " + diffWeeks + (diffWeeks === 1 ? " sem" : " semanas");
        var diffMonths = Math.floor(diffDays / 30);
        return "Hace " + diffMonths + (diffMonths === 1 ? " mes" : " meses");
      }
      return dateString || "Hace unos momentos";
    }

    function getMyReviewIds() {
      try {
        var stored = localStorage.getItem("tecnoplus_my_review_ids");
        return stored ? JSON.parse(stored) : [];
      } catch(e) {
        return [];
      }
    }

    function addMyReviewId(id) {
      try {
        var ids = getMyReviewIds();
        if (ids.indexOf(id) === -1) {
          ids.push(id);
          localStorage.setItem("tecnoplus_my_review_ids", JSON.stringify(ids));
        }
      } catch(e) {}
    }

    function removeMyReviewId(id) {
      try {
        var ids = getMyReviewIds().filter(function(i) { return i !== id; });
        localStorage.setItem("tecnoplus_my_review_ids", JSON.stringify(ids));
      } catch(e) {}
    }

    function getLikedReviewIds() {
      try {
        var stored = localStorage.getItem("tecnoplus_liked_reviews");
        return stored ? JSON.parse(stored) : {};
      } catch(e) {
        return {};
      }
    }

    function setReviewLiked(id) {
      try {
        var liked = getLikedReviewIds();
        liked[id] = true;
        localStorage.setItem("tecnoplus_liked_reviews", JSON.stringify(liked));
      } catch(e) {}
    }

    function updateCounters() {
      var total = allReviews.length;
      var f5 = allReviews.filter(function(r) { return Math.round(Number(r.rating)) === 5; }).length;
      var f4 = allReviews.filter(function(r) { return Math.round(Number(r.rating)) === 4; }).length;

      var totalVerifiedEl = document.getElementById("rev-total-verified");
      if (totalVerifiedEl) totalVerifiedEl.textContent = total + " Opiniones Verificadas en Colombia";

      var pAll = document.getElementById("count-pill-all");
      if (pAll) pAll.textContent = total;
      var p5 = document.getElementById("count-pill-5");
      if (p5) p5.textContent = f5;
      var p4 = document.getElementById("count-pill-4");
      if (p4) p4.textContent = f4;
    }

    function renderStage() {
      var stage = document.getElementById("tp-dynamic-reviews-stage");
      var counter = document.getElementById("rev-counter");
      if (!stage) return;

      if (filteredReviews.length === 0) {
        stage.innerHTML = '<div style="text-align: center; padding: 40px 20px; color: #6b7280;">' +
          '<div style="font-size: 32px; margin-bottom: 8px;">💬</div>' +
          '<p style="font-weight: 700; color: #111; margin: 0 0 4px;">No hay opiniones en este filtro</p>' +
          '<p style="font-size: 13px; margin: 0 0 14px;">Sé el primero en compartir tu experiencia.</p>' +
          '<button type="button" class="tp-filter-pill tp-filter-btn" onclick="openNewReviewModal()">Dejar mi opinión</button>' +
          '</div>';
        if (counter) counter.textContent = "0 / 0";
        return;
      }

      if (currentIndex >= filteredReviews.length) {
        currentIndex = 0;
      }

      stage.innerHTML = "";
      var myIds = getMyReviewIds();
      var likedMap = getLikedReviewIds();

      filteredReviews.forEach(function(rev, idx) {
        var card = document.createElement("div");
        card.className = "tp-review-card";

        if (idx === currentIndex) {
          card.classList.add("active");
        } else if (idx === (currentIndex - 1 + filteredReviews.length) % filteredReviews.length) {
          card.classList.add("prev");
        } else if (idx === (currentIndex + 1) % filteredReviews.length) {
          card.classList.add("next");
        } else {
          card.classList.add("hidden-card");
        }

        var isMy = myIds.indexOf(rev.id) !== -1;
        var deleteBtnHtml = isMy ?
          '<button type="button" class="tp-del-my-rev" onclick="event.stopPropagation(); window.deleteMyReview(\'' + rev.id + '\')" title="Borrar mi comentario">' +
            '<span>🗑️</span><span>Borrar</span>' +
          '</button>' : '';

        var isLiked = Boolean(likedMap[rev.id]);
        var likesCount = rev.likes || 0;

        // Avatar
        var colorIdx = (rev.name || "A").charCodeAt(0) % AVATAR_COLORS.length;
        var avatarBg = AVATAR_COLORS[colorIdx];
        var initialLetter = (rev.name || "U").charAt(0).toUpperCase();

        var avatarHtml = rev.avatar_url ?
          '<div class="tp-avatar"><img src="' + rev.avatar_url + '" alt="' + escapeHtml(rev.name) + '" class="tp-avatar-img" onerror="this.style.display=\'none\'; this.parentElement.textContent=\'' + initialLetter + '\'"></div>' :
          '<div class="tp-avatar" style="background: ' + avatarBg + ';">' + initialLetter + '</div>';

        var starsStr = "★★★★★".substring(0, Math.min(5, Math.max(0, Math.round(rev.rating || 5))));
        while (starsStr.length < 5) starsStr += "☆";

        var recHtml = rev.recommended !== false ? '<span class="tp-badge-recomienda">● Recomienda</span>' : '';
        var timeAgoText = formatTimeAgo(rev.created_at, rev.date, rev.id);

        card.innerHTML =
          '<div class="tp-review-header">' +
            avatarHtml +
            '<div class="tp-user-info">' +
              '<b>' + escapeHtml(rev.name) + '</b>' +
              '<span>📍 ' + escapeHtml(rev.city || "Montería, Córdoba") + '</span>' +
            '</div>' +
            '<div class="tp-header-right">' +
              '<span class="tp-review-time">⏱️ ' + timeAgoText + '</span>' +
              deleteBtnHtml +
            '</div>' +
          '</div>' +
          '<div class="tp-rating-row">' +
            '<span class="tp-stars">' + starsStr + '</span>' +
            '<span class="tp-score">' + Number(rev.rating || 5).toFixed(1) + '</span>' +
            recHtml +
          '</div>' +
          '<h4>' + escapeHtml(rev.title || "Excelente experiencia") + '</h4>' +
          '<p>' + escapeHtml(rev.comment || "") + '</p>' +
          '<div class="tp-review-footer">' +
            '<span class="tp-tag">📦 ' + escapeHtml(rev.product || "Celulares & Tecnología") + '</span>' +
            '<button type="button" class="tp-like-btn ' + (isLiked ? 'liked' : '') + '" onclick="event.stopPropagation(); window.toggleLike(\'' + rev.id + '\')">' +
              '<span>👍</span><span id="like-count-' + rev.id + '">' + likesCount + '</span>' +
            '</button>' +
          '</div>';

        card.onclick = function() {
          if (idx !== currentIndex) {
            currentIndex = idx;
            renderStage();
          }
        };

        stage.appendChild(card);
      });

      if (counter) {
        counter.textContent = (currentIndex + 1) + " / " + filteredReviews.length;
      }
    }

    function applyFilter(cat) {
      currentFilter = cat;
      document.querySelectorAll(".tp-reviews-filters .tp-filter-pill:not(.tp-filter-btn)").forEach(function(pill) {
        pill.classList.remove("active");
      });
      var activePill = document.getElementById("pill-" + cat);
      if (activePill) activePill.classList.add("active");

      if (cat === "5") {
        filteredReviews = allReviews.filter(function(r) { return Math.round(Number(r.rating)) === 5; });
      } else if (cat === "4") {
        filteredReviews = allReviews.filter(function(r) { return Math.round(Number(r.rating)) === 4; });
      } else {
        filteredReviews = allReviews.slice();
      }
      currentIndex = 0;
      renderStage();
    }

    window.filterReviewsCategory = function(cat) {
      applyFilter(cat);
    };

    window.nextReview = function() {
      if (!filteredReviews.length) return;
      currentIndex = (currentIndex + 1) % filteredReviews.length;
      renderStage();
    };

    window.prevReview = function() {
      if (!filteredReviews.length) return;
      currentIndex = (currentIndex - 1 + filteredReviews.length) % filteredReviews.length;
      renderStage();
    };

    // Dar Like
    window.toggleLike = function(id) {
      var likedMap = getLikedReviewIds();
      if (likedMap[id]) return; // ya le dio like

      setReviewLiked(id);

      var rev = allReviews.find(function(r) { return r.id === id; });
      if (rev) {
        rev.likes = (rev.likes || 0) + 1;
        var countEl = document.getElementById("like-count-" + id);
        if (countEl) countEl.textContent = rev.likes;
        var btn = countEl ? countEl.parentElement : null;
        if (btn) btn.classList.add("liked");

        // Enviar a Supabase
        fetch(SUPABASE_URL + "?id=eq." + encodeURIComponent(id), {
          method: "PATCH",
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": "Bearer " + SUPABASE_KEY,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ likes: rev.likes })
        }).catch(function(err) {
          console.warn("Error updating like on Supabase:", err);
        });
      }
    };

    // Borrar SOLO mi propio comentario
    window.deleteMyReview = function(id) {
      var myIds = getMyReviewIds();
      if (myIds.indexOf(id) === -1) {
        alert("Solo puedes eliminar las opiniones publicadas desde tu dispositivo.");
        return;
      }

      if (!confirm("¿Estás seguro de que deseas eliminar tu opinión? Esta acción no se puede deshacer.")) {
        return;
      }

      // Eliminar de Supabase
      fetch(SUPABASE_URL + "?id=eq." + encodeURIComponent(id), {
        method: "DELETE",
        headers: {
          "apikey": SUPABASE_KEY,
          "Authorization": "Bearer " + SUPABASE_KEY
        }
      }).then(function(res) {
        if (!res.ok) throw new Error("Error en servidor");
        removeMyReviewId(id);
        allReviews = allReviews.filter(function(r) { return r.id !== id; });
        applyFilter(currentFilter);
        updateCounters();
        alert("Tu opinión ha sido eliminada con éxito.");
      }).catch(function(err) {
        console.error("Error al eliminar reseña:", err);
        alert("No se pudo eliminar la reseña. Por favor verifica tu conexión.");
      });
    };

    // Modal Control
    window.openNewReviewModal = function() {
      var modal = document.getElementById("tp-new-review-modal");
      if (modal) {
        modal.style.setProperty("display", "flex", "important");
        document.body.style.overflow = "hidden";
      }
    };

    window.closeNewReviewModal = function() {
      var modal = document.getElementById("tp-new-review-modal");
      if (modal) {
        modal.style.setProperty("display", "none", "important");
        document.body.style.overflow = "";
      }
    };

    // Attach direct listeners
    try {
      var btnDejar = document.getElementById("tp-btn-dejar-opinion");
      if (btnDejar) {
        btnDejar.onclick = function(e) {
          if (e) e.preventDefault();
          window.openNewReviewModal();
        };
      }
    } catch(e) {}

    window.selectRating = function(stars) {
      document.getElementById("tp-rev-rating").value = stars;
      var textEl = document.getElementById("tp-rating-text");
      if (textEl && RATING_DESCRIPTIONS[stars]) {
        textEl.textContent = RATING_DESCRIPTIONS[stars];
      }
      var starSpans = document.querySelectorAll("#tp-star-picker span");
      starSpans.forEach(function(s, idx) {
        if (idx < stars) {
          s.style.color = "#f59e0b";
        } else {
          s.style.color = "#d1d5db";
        }
      });
    };

    // Foto de perfil con compresión canvas
    window.handlePhotoUpload = function(input) {
      if (!input.files || !input.files[0]) return;
      var file = input.files[0];
      var reader = new FileReader();

      reader.onload = function(e) {
        var img = new Image();
        img.onload = function() {
          var maxDim = 140;
          var w = img.width;
          var h = img.height;
          if (w > h) {
            if (w > maxDim) { h = Math.round((h * maxDim) / w); w = maxDim; }
          } else {
            if (h > maxDim) { w = Math.round((w * maxDim) / h); h = maxDim; }
          }
          var canvas = document.createElement("canvas");
          canvas.width = w;
          canvas.height = h;
          var ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, w, h);
          var dataUrl = canvas.toDataURL("image/jpeg", 0.82);

          document.getElementById("tp-rev-avatar-data").value = dataUrl;
          var previewImg = document.getElementById("tp-avatar-preview-img");
          var placeholder = document.getElementById("tp-avatar-placeholder-icon");
          var removeBtn = document.getElementById("tp-remove-photo-btn");

          if (previewImg && placeholder && removeBtn) {
            previewImg.src = dataUrl;
            previewImg.style.display = "block";
            placeholder.style.display = "none";
            removeBtn.style.display = "inline";
          }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    };

    window.removeSelectedPhoto = function() {
      document.getElementById("tp-rev-avatar-data").value = "";
      document.getElementById("tp-rev-photo-input").value = "";
      var previewImg = document.getElementById("tp-avatar-preview-img");
      var placeholder = document.getElementById("tp-avatar-placeholder-icon");
      var removeBtn = document.getElementById("tp-remove-photo-btn");
      if (previewImg && placeholder && removeBtn) {
        previewImg.style.display = "none";
        placeholder.style.display = "block";
        removeBtn.style.display = "none";
      }
    };

    // Publicar Opinión
    window.handleReviewSubmit = function(e) {
      e.preventDefault();
      var errEl = document.getElementById("tp-rev-form-error");
      if (errEl) errEl.style.display = "none";

      var name = document.getElementById("tp-rev-name").value.trim();
      var city = document.getElementById("tp-rev-city").value.trim() || "Montería, Córdoba";
      var rating = Number(document.getElementById("tp-rev-rating").value) || 5;
      var product = document.getElementById("tp-rev-product").value;
      var title = document.getElementById("tp-rev-title").value.trim() || (rating >= 4 ? "¡Excelente experiencia!" : "Opinión del producto");
      var comment = document.getElementById("tp-rev-comment").value.trim();
      var recommended = document.getElementById("tp-rev-recommended").checked;
      var avatarUrl = document.getElementById("tp-rev-avatar-data").value.trim() || null;

      if (!name) {
        if (errEl) { errEl.textContent = "Por favor ingresa tu nombre completo."; errEl.style.display = "block"; }
        return;
      }
      if (!comment || comment.length < 10) {
        if (errEl) { errEl.textContent = "Por favor escribe un comentario de al menos 10 caracteres."; errEl.style.display = "block"; }
        return;
      }

      var submitBtn = document.getElementById("tp-submit-review-btn");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Publicando en Tecno+...</span>';
      }

      var reviewId = "rev-" + Date.now() + "-" + Math.random().toString(36).substring(2, 7);

      var newReviewPayload = {
        id: reviewId,
        name: name,
        city: city,
        rating: rating,
        date: "Hace unos momentos",
        product: product,
        title: title,
        comment: comment,
        verified: true,
        recommended: recommended,
        likes: 0,
        avatar_url: avatarUrl,
        created_at: new Date().toISOString()
      };

      // Guardar en Supabase
      fetch(SUPABASE_URL, {
        method: "POST",
        headers: {
          "apikey": SUPABASE_KEY,
          "Authorization": "Bearer " + SUPABASE_KEY,
          "Content-Type": "application/json",
          "Prefer": "return=representation"
        },
        body: JSON.stringify(newReviewPayload)
      })
      .then(function(res) {
        if (!res.ok) throw new Error("Error al publicar");
        return res.json();
      })
      .then(function() {
        addMyReviewId(reviewId);
        allReviews.unshift(newReviewPayload);
        applyFilter("all");
        updateCounters();
        closeNewReviewModal();

        // Reset form
        document.getElementById("tp-rev-form-error").style.display = "none";
        document.getElementById("tp-rev-title").value = "";
        document.getElementById("tp-rev-comment").value = "";
        removeSelectedPhoto();

        alert("¡Tu opinión ha sido publicada exitosamente y ya es visible para toda la comunidad de Tecno+!");
      })
      .catch(function(err) {
        console.error("Error al publicar opinión:", err);
        // Fallback optimista local
        addMyReviewId(reviewId);
        allReviews.unshift(newReviewPayload);
        applyFilter("all");
        updateCounters();
        closeNewReviewModal();
        alert("¡Tu opinión ha sido añadida exitosamente!");
      })
      .finally(function() {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Publicar mi opinión ahora</span><span>→</span>';
        }
      });
    };

    // Cargar opiniones desde Supabase
    fetch(SUPABASE_URL + "?select=*&order=created_at.desc", {
      headers: {
        "apikey": SUPABASE_KEY,
        "Authorization": "Bearer " + SUPABASE_KEY
      }
    })
    .then(function(res) {
      if (!res.ok) throw new Error("Error HTTP " + res.status);
      return res.json();
    })
    .then(function(data) {
      if (Array.isArray(data) && data.length > 0) {
        allReviews = data;
      }
      applyFilter("all");
      updateCounters();
    })
    .catch(function(err) {
      console.warn("Cargando opiniones de respaldo:", err);
      // Fallback si la conexión inicial tarda
      allReviews = [
        {
          id: "rev-g1",
          name: "María Fernanda Getial Pastrana",
          city: "Montería, Córdoba",
          rating: 5,
          date: "Hace 3 días",
          product: "Celulares & Tecnología",
          title: "Súper buena atención y precios justos",
          comment: "Súper buena atención, los precios justos y me ha encantado mi celular.",
          verified: true,
          recommended: true,
          likes: 18,
          created_at: new Date(Date.now() - 3 * 86400000).toISOString()
        },
        {
          id: "rev-g2",
          name: "Kiara Yanez",
          city: "Montería, Córdoba",
          rating: 5,
          date: "Hace 5 días",
          product: "Celulares & Tecnología",
          title: "Me gustó mucho el servicio",
          comment: "Me gustó mucho el servicio, muy buena la atención. Lo recomendaría.",
          verified: true,
          recommended: true,
          likes: 17,
          created_at: new Date(Date.now() - 5 * 86400000).toISOString()
        },
        {
          id: "rev-g3",
          name: "Diego",
          city: "Montería, Córdoba",
          rating: 5,
          date: "Hace 5 días",
          product: "Cómputo & Laptops",
          title: "Excelentes instalaciones y atención",
          comment: "Excelente servicio al cliente, buenas instalaciones y atención, productos de calidad garantizada.",
          verified: true,
          recommended: true,
          likes: 19,
          created_at: new Date(Date.now() - 5 * 86400000).toISOString()
        },
        {
          id: "rev-g4",
          name: "Cindy Montaño",
          city: "Montería, Córdoba",
          rating: 5,
          date: "Hace 6 días",
          product: "Celulares & Tecnología",
          title: "Súper recomendado",
          comment: "Compré mi teléfono con entrega rápida el mismo día en Montería. Muy amables y atentos.",
          verified: true,
          recommended: true,
          likes: 21,
          created_at: new Date(Date.now() - 6 * 86400000).toISOString()
        }
      ];
      applyFilter("all");
      updateCounters();
    });

    // Auto rotación suave del carrusel cada 5 segundos
    autoRotateInterval = setInterval(function() {
      if (filteredReviews.length > 1) {
        currentIndex = (currentIndex + 1) % filteredReviews.length;
        renderStage();
      }
    }, 5500);

    // Inicializar picker de 5 estrellas
    window.selectRating(5);
  })();
</script>

{% schema %}
{
  "name": "Tecno+ Opiniones",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Lo que dicen nuestros clientes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Experiencias reales de compradores en Montería y toda Colombia. Haz clic en cualquier tarjeta para enfocarla."
    }
  ],
  "presets": [
    {
      "name": "Tecno+ Opiniones"
    }
  ]
}
{% endschema %}

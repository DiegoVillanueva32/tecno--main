{%- comment -%}
  Tecno+ Infinite Smooth Marquee Bar
{%- endcomment -%}

<div class="tp-announcement" aria-label="Información de envíos y garantías">
  <div class="tp-announcement-track">
    {%- for i in (1..2) -%}
      <div class="tp-announcement-group">
        <span class="tp-announcement-item">{{ section.settings.text_1 | default: 'Compra segura' }}</span>
        <span class="tp-dot">·</span>
        <span class="tp-announcement-item">{{ section.settings.text_2 | default: 'Montería, Córdoba' }}</span>
        <span class="tp-dot">·</span>
        <span class="tp-announcement-item">{{ section.settings.text_3 | default: 'Garantía oficial Tecno+' }}</span>
        <span class="tp-dot">·</span>
        <span class="tp-announcement-item">{{ section.settings.text_4 | default: 'Pagos en línea con PSE, Tarjetas y Nequi' }}</span>
        <span class="tp-dot">·</span>
        <span class="tp-announcement-item">{{ section.settings.text_5 | default: 'Envíos 24-48h a toda Colombia' }}</span>
        <span class="tp-dot">·</span>
        <span class="tp-announcement-item">{{ section.settings.text_6 | default: 'Envío gratis a todo Colombia' }}</span>
        <span class="tp-dot">·</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .tp-announcement {
    background: #0c0c0c;
    color: #ffffff;
    overflow: hidden;
    padding: 8px 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    user-select: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 32px,
      black calc(100% - 32px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 32px,
      black calc(100% - 32px),
      transparent 100%
    );
  }

  .tp-announcement-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: tp-announcement-marquee 24s linear infinite;
  }

  .tp-announcement:hover .tp-announcement-track {
    animation-play-state: paused;
  }

  .tp-announcement-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .tp-announcement-item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 0 4px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  }

  .tp-dot {
    color: #e02424;
    margin: 0 14px;
    font-weight: 700;
    font-size: 14px;
  }

  @keyframes tp-announcement-marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tecno+ Marquee Bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Texto 1",
      "default": "Compra segura"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Texto 2",
      "default": "Montería, Córdoba"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Texto 3",
      "default": "Garantía oficial Tecno+"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Texto 4",
      "default": "Pagos en línea con PSE, Tarjetas y Nequi"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Texto 5",
      "default": "Envíos 24-48h a toda Colombia"
    },
    {
      "type": "text",
      "id": "text_6",
      "label": "Texto 6",
      "default": "Envío gratis a todo Colombia"
    }
  ],
  "presets": [
    {
      "name": "Tecno+ Marquee Bar"
    }
  ]
}
{% endschema %}

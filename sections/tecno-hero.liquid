          <button class="tp-hero-arrow tp-hero-prev" type="button" data-tp-hero-prev aria-label="Producto anterior">
            <span aria-hidden="true">‹</span>
          </button>
          <button class="tp-hero-arrow tp-hero-next" type="button" data-tp-hero-next aria-label="Siguiente producto">
            <span aria-hidden="true">›</span>
          </button>
          <div class="tp-hero-dots" aria-label="Elegir producto">
            <button class="tp-hero-dot is-active" type="button" data-tp-hero-dot="0" aria-label="Ver producto 1" aria-current="true"></button>
            <button class="tp-hero-dot" type="button" data-tp-hero-dot="1" aria-label="Ver producto 2" aria-current="false"></button>
            <button class="tp-hero-dot" type="button" data-tp-hero-dot="2" aria-label="Ver producto 3" aria-current="false"></button>
            <button class="tp-hero-dot" type="button" data-tp-hero-dot="3" aria-label="Ver producto 4" aria-current="false"></button>
            <button class="tp-hero-dot" type="button" data-tp-hero-dot="4" aria-label="Ver producto 5" aria-current="false"></button>
            <button class="tp-hero-dot" type="button" data-tp-hero-dot="5" aria-label="Ver producto 6" aria-current="false"></button>
            <button class="tp-hero-dot" type="button" data-tp-hero-dot="6" aria-label="Ver producto 7" aria-current="false"></button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .tp-hero-section {
    min-height: min(720px, calc(100vh - 65px));
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #ffffff;
    padding: 56px 0 64px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  }

  .tp-hero-container {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  .tp-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
  }

  .tp-hero-content {
    max-width: 590px;
    text-align: left;
  }

  .tp-eyebrow {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    font-weight: 800;
    color: #e02424;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .tp-hero-title {
    font-size: clamp(40px, 5.1vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.045em;
    margin: 12px 0 24px;
    font-weight: 900;
    color: #111111;
  }

  .tp-hero-title span {
    color: #e02424;
  }

  .tp-hero-subtitle {
    color: #666666;
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 30px;
    max-width: 520px;
  }

  .tp-hero-actions {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .tp-btn {
    padding: 14px 26px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
    border: none;
    line-height: 1;
  }

  .tp-btn-primary {
    background: #e02424;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(224, 36, 36, 0.3);
  }

  .tp-btn-primary:hover {
    background: #b91c1c;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(224, 36, 36, 0.4);
  }

  .tp-btn-secondary {
    background: #ffffff;
    border: 1px solid #dcdcdc;
    color: #111111 !important;
  }

  .tp-btn-secondary:hover {
    border-color: #888888;
    background: #fbfbfb;
    transform: translateY(-2px);
  }

  .tp-hero-carousel {
    position: relative;
    min-width: 0;
    padding: 18px 18px 62px;
    border: 1px solid #eceef1;
    border-radius: 30px;
    background: linear-gradient(145deg, #fafafa, #f1f2f4);
    box-shadow: 0 24px 60px rgba(17, 24, 39, 0.1);
  }

  .tp-hero-slides {
    position: relative;
    min-height: 420px;
  }

  .tp-hero-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(14px);
    transition: opacity 350ms ease, transform 350ms ease, visibility 350ms;
  }

  .tp-hero-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .tp-hero-product-image {
    min-height: 300px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 20px;
    background: #ffffff;
  }

  .tp-hero-product-image img,
  .tp-hero-placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    max-height: 390px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .tp-hero-product-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 4px 0;
  }

  .tp-hero-product-copy {
    min-width: 0;
  }

  .tp-hero-product-label {
    display: block;
    margin-bottom: 6px;
    color: #e02424;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .tp-hero-product-title {
    display: block;
    overflow: hidden;
    color: #111111;
    font-size: clamp(16px, 1.6vw, 21px);
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    text-overflow: ellipsis;
  }

  .tp-hero-product-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 6px;
  }

  .tp-hero-product-price strong {
    color: #111111;
    font-size: 18px;
    font-weight: 800;
  }

  .tp-hero-product-price s {
    color: #8a8f98;
    font-size: 13px;
  }

  .tp-hero-add-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 160px;
    padding: 13px 17px;
    border: 0;
    border-radius: 999px;
    background: #e02424;
    color: #ffffff;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .tp-hero-add-button:hover {
    background: #b91c1c;
    transform: translateY(-1px);
  }

  .tp-hero-sold-out {
    background: #111111;
  }

  .tp-hero-arrow {
    position: absolute;
    z-index: 2;
    top: 42%;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid #e3e5e8;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    color: #111111;
    box-shadow: 0 4px 14px rgba(17, 24, 39, 0.12);
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .tp-hero-arrow span {
    font-size: 28px;
    line-height: 1;
  }

  .tp-hero-arrow:hover {
    transform: scale(1.05);
    border-color: #e02424;
    color: #e02424;
  }

  .tp-hero-prev {
    left: 0;
    transform: translateX(-50%);
  }

  .tp-hero-prev:hover {
    transform: translateX(-50%) scale(1.05);
  }

  .tp-hero-next {
    right: 0;
    transform: translateX(50%);
  }

  .tp-hero-next:hover {
    transform: translateX(50%) scale(1.05);
  }

  .tp-hero-dots {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .tp-hero-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #c7cbd1;
    cursor: pointer;
    transition: width 180ms ease, background 180ms ease;
  }

  .tp-hero-dot.is-active {
    width: 24px;
    background: #e02424;
  }

  .tp-hero-fallback {
    min-height: 400px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 20px;
    background: #ffffff;
  }

  .tp-hero-fallback img {
    width: 100%;
    height: 100%;
    min-height: 400px;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .tp-hero-section {
      min-height: auto;
      padding: 48px 0 54px;
    }

    .tp-hero-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .tp-hero-content {
      max-width: 680px;
    }

    .tp-hero-carousel {
      width: min(100%, 680px);
      margin: 0 auto;
    }

    .tp-hero-slides {
      min-height: 390px;
    }
  }

  @media (max-width: 560px) {
    .tp-hero-container {
      width: calc(100% - 32px);
    }

    .tp-hero-title {
      font-size: 36px;
      margin: 10px 0 18px;
    }

    .tp-hero-subtitle {
      font-size: 15px;
      margin-bottom: 22px;
    }

    .tp-hero-actions {
      gap: 10px;
    }

    .tp-btn {
      width: 100%;
      padding: 13px 20px;
    }

    .tp-hero-carousel {
      padding: 10px 10px 52px;
      border-radius: 22px;
    }

    .tp-hero-slides {
      min-height: 365px;
    }

    .tp-hero-product-image,
    .tp-hero-product-image img,
    .tp-hero-placeholder {
      min-height: 255px;
    }

    .tp-hero-product-info {
      align-items: stretch;
      flex-direction: column;
      gap: 12px;
      padding: 14px 4px 0;
    }

    .tp-hero-add-button {
      width: 100%;
    }

    .tp-hero-arrow {
      top: 34%;
      width: 36px;
      height: 36px;
    }

    .tp-hero-prev {
      left: 5px;
      transform: none;
    }

    .tp-hero-prev:hover {
      transform: scale(1.05);
    }

    .tp-hero-next {
      right: 5px;
      transform: none;
    }

    .tp-hero-next:hover {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-hero-slide,
    .tp-hero-dot,
    .tp-hero-arrow,
    .tp-hero-add-button {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('#hero-{{ section.id }} [data-tp-hero-carousel]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const slides = Array.from(root.querySelectorAll('[data-tp-hero-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-tp-hero-dot]'));
    if (slides.length < 2) return;

    let currentIndex = 0;
    let timer;
    const interval = Number(root.dataset.autoplayMs) || 7000;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const showSlide = (nextIndex) => {
      currentIndex = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const isActive = index === currentIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
        slide.querySelectorAll('a, button, input').forEach((element) => {
          element.tabIndex = isActive ? 0 : -1;
        });
      });
      dots.forEach((dot, index) => {
        const isActive = index === currentIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-current', String(isActive));
      });
    };

    const stopAutoplay = () => window.clearInterval(timer);
    const startAutoplay = () => {
      stopAutoplay();
      if (!reducedMotion) timer = window.setInterval(() => showSlide(currentIndex + 1), interval);
    };

    root.querySelector('[data-tp-hero-prev]')?.addEventListener('click', () => {
      showSlide(currentIndex - 1);
      startAutoplay();
    });
    root.querySelector('[data-tp-hero-next]')?.addEventListener('click', () => {
      showSlide(currentIndex + 1);
      startAutoplay();
    });
    dots.forEach((dot) => dot.addEventListener('click', () => {
      showSlide(Number(dot.dataset.tpHeroDot));
      startAutoplay();
    }));

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget)) startAutoplay();
    });

    startAutoplay();
  })();
</script>


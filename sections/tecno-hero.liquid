{%- liquid
  assign hero_collection = section.settings.collection
-%}

<section class="tp-hero-section" id="hero-{{ section.id }}">
  <div class="tp-hero-container">
    <div class="tp-hero-layout">
      <div class="tp-hero-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="tp-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h1 class="tp-hero-title">
          {{ section.settings.title | default: 'La tecnología que quieres <span>más cerca de ti.</span>' }}
        </h1>

        {%- if section.settings.subtitle != blank -%}
          <p class="tp-hero-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="tp-hero-actions">
          {%- if section.settings.btn1_text != blank -%}
            <a href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}" class="tp-btn tp-btn-primary">
              {{ section.settings.btn1_text }}
            </a>
          {%- endif -%}

          {%- if section.settings.btn2_text != blank -%}
            <a
              href="{{ section.settings.btn2_link | default: 'https://wa.me/573043547935?text=Hola%20Tecno%2B%2C%20quiero%20asesor%C3%ADa%20para%20elegir%20un%20producto' }}"
              class="tp-btn tp-btn-secondary"
              {% if section.settings.btn2_link contains 'wa.me' or section.settings.btn2_link contains 'http' %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.btn2_text }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div
        class="tp-hero-carousel"
        data-tp-hero-carousel
        data-autoplay-ms="{{ section.settings.autoplay_seconds | times: 1000 }}"
        aria-label="Productos destacados"
      >
        {%- if hero_collection != blank and hero_collection.products_count > 0 -%}
          <div class="tp-hero-slides" aria-live="polite">
            {%- for product in hero_collection.products limit: section.settings.products_to_show -%}
              {%- assign hero_variant = product.selected_or_first_available_variant -%}
              <article
                class="tp-hero-slide{% if forloop.first %} is-active{% endif %}"
                data-tp-hero-slide
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              >
                <a class="tp-hero-product-image" href="{{ product.url }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '480, 720, 960, 1200',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'tp-hero-placeholder' }}
                  {%- endif -%}
                </a>

                <div class="tp-hero-product-info">
                  <div class="tp-hero-product-copy">
                    <span class="tp-hero-product-label">TECNO+ · PRODUCTO DESTACADO</span>
                    <a class="tp-hero-product-title" href="{{ product.url }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
                      {{ product.title | escape }}
                    </a>
                    <div class="tp-hero-product-price">
                      {%- if product.compare_at_price > product.price -%}
                        <s>{{ product.compare_at_price | money }}</s>
                      {%- endif -%}
                      <strong>{{ product.price | money }}</strong>
                    </div>
                  </div>

                  {%- if product.available and hero_variant != blank -%}
                    <form class="tp-hero-add-form" method="post" action="{{ routes.cart_add_url }}">
                      <input type="hidden" name="id" value="{{ hero_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button class="tp-hero-add-button" type="submit">
                        <span>Agregar al carrito</span>
                        <span aria-hidden="true">+</span>
                      </button>
                    </form>
                  {%- else -%}
                    <a class="tp-hero-add-button tp-hero-sold-out" href="{{ product.url }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
                      Ver producto
                      <span aria-hidden="true">→</span>
                    </a>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>

          {%- if hero_collection.products_count > 1 -%}
            <button class="tp-hero-arrow tp-hero-prev" type="button" data-tp-hero-prev aria-label="Producto anterior">
              <span aria-hidden="true">‹</span>
            </button>
            <button class="tp-hero-arrow tp-hero-next" type="button" data-tp-hero-next aria-label="Siguiente producto">
              <span aria-hidden="true">›</span>
            </button>
            <div class="tp-hero-dots" aria-label="Elegir producto">
              {%- for product in hero_collection.products limit: section.settings.products_to_show -%}
                <button
                  class="tp-hero-dot{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-tp-hero-dot="{{ forloop.index0 }}"
                  aria-label="Ver producto {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="tp-hero-slides" aria-live="polite">
            {%- comment -%} 1. Parlante (Bocina) {%- endcomment -%}
            <article class="tp-hero-slide is-active" data-tp-hero-slide aria-hidden="false">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="0">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/parlante_rgb.png?v=1791928275"
                  alt="Parlante Premium Recargable 30W"
                  loading="eager"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · AUDIO & SONIDO</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="0">Parlante Premium Recargable 30W</a>
                  <div class="tp-hero-product-price">
                    <strong>$ 260.000</strong>
                  </div>
                </div>
                <a class="tp-hero-add-button" href="/collections/all" tabindex="0">
                  <span>Ver producto</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            {%- comment -%} 2. iPhone 18 Pro Max {%- endcomment -%}
            <article class="tp-hero-slide" data-tp-hero-slide aria-hidden="true">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="-1">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/phone18proax.webp?v=1791928266"
                  alt="iPhone 18 Pro Max"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · PREVENTA 2026</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="-1">iPhone 18 Pro Max</a>
                  <div class="tp-hero-product-price">
                    <strong>$ 6.400.000</strong>
                  </div>
                </div>
                <a class="tp-hero-add-button" href="/collections/all" tabindex="-1">
                  <span>Ver producto</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            {%- comment -%} 3. Diademas AirPods Max 1:1 {%- endcomment -%}
            <article class="tp-hero-slide" data-tp-hero-slide aria-hidden="true">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="-1">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/headphones.png?v=1791928274"
                  alt="Diadema AirPods Max 1:1 Cancelación de Ruido"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · CANCELACIÓN DE RUIDO</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="-1">Diadema AirPods Max 1:1</a>
                  <div class="tp-hero-product-price">
                    <strong>$ 85.000</strong>
                  </div>
                </div>
                <a class="tp-hero-add-button" href="/collections/all" tabindex="-1">
                  <span>Ver producto</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            {%- comment -%} 4. iPhone 17 Pro Max {%- endcomment -%}
            <article class="tp-hero-slide" data-tp-hero-slide aria-hidden="true">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="-1">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/iphone17promax.webp?v=1791928268"
                  alt="iPhone 17 Pro Max"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · TOP VENTAS</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="-1">iPhone 17 Pro Max</a>
                  <div class="tp-hero-product-price">
                    <strong>$ 4.500.000</strong>
                  </div>
                </div>
                <a class="tp-hero-add-button" href="/collections/all" tabindex="-1">
                  <span>Ver producto</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            {%- comment -%} 5. Smartwatch Ultra {%- endcomment -%}
            <article class="tp-hero-slide" data-tp-hero-slide aria-hidden="true">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="-1">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/apple_watch_ultra.jpg?v=1791928270"
                  alt="Apple Watch Ultra 2 Titanium"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · TITANIO</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="-1">Smartwatch Ultra Titanium</a>
                  <div class="tp-hero-product-price">
                    <strong>$ 890.000</strong>
                  </div>
                </div>
                <a class="tp-hero-add-button" href="/collections/all" tabindex="-1">
                  <span>Ver producto</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            {%- comment -%} 6. Celular Samsung {%- endcomment -%}
            <article class="tp-hero-slide" data-tp-hero-slide aria-hidden="true">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="-1">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/samsung_s24_ultra.png?v=1791928269"
                  alt="Samsung Galaxy S26 Ultra"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · GALAXY AI</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="-1">Samsung Galaxy S26 Ultra</a>
                  <div class="tp-hero-product-price">
                    <s>$ 4.190.000</s>
                    <strong>$ 3.450.000</strong>
                  </div>
                </div>
                <a class="tp-hero-add-button" href="/collections/all" tabindex="-1">
                  <span>Ver producto</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            {%- comment -%} 7. Computador Laptop {%- endcomment -%}
            <article class="tp-hero-slide" data-tp-hero-slide aria-hidden="true">
              <a class="tp-hero-product-image" href="/collections/all" tabindex="-1">
                <img
                  src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/lenovo.png?v=1791928275"
                  alt="Lenovo IdeaPad Slim 3 15IRH10"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              </a>
              <div class="tp-hero-product-info">
                <div class="tp-hero-product-copy">
                  <span class="tp-hero-product-label">TECNO+ · LAPTOPS & CÓMPUTO</span>
                  <a class="tp-hero-product-title" href="/collections/all" tabindex="-1">Lenovo IdeaPad Slim 3 15IRH10</a>
                  <div class="tp-hero-product-price">
                    <s>$ 3.190.000</s>

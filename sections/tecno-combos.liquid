{%- comment -%}
  Tecno+ Combos Ahorradores Section
  Diseño idéntico a la referencia: fondo blanco, tarjetas redondeadas limpias, cuotas en rojo, botón píldora.
{%- endcomment -%}

<section id="combos" class="tp-combos-section">
  <div class="tp-combos-container">
    <div class="tp-combos-head">
      <div>
        <span class="tp-combos-eyebrow">{{ section.settings.eyebrow | default: 'AHORRA MÁS' }}</span>
        <h2 class="tp-combos-title">{{ section.settings.title | default: 'Combos Tecno+' }}</h2>
      </div>
      <p class="tp-combos-desc">
        {{ section.settings.description | default: 'Paquetes seleccionados para llevar más tecnología por un solo precio.' }}
      </p>
    </div>

    <div class="tp-combos-grid">
      {%- comment -%} Combo 1: Samsung S25 Ultra {%- endcomment -%}
      <article class="tp-combo-card">
        <div class="tp-combo-card-img">
          <img src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-samsung.png?v=1791928273" alt="Forro Rígido + Vidrio Pantalla Para Samsung Galaxy S25 Ultra" loading="lazy">
        </div>
        <div class="tp-combo-card-info">
          <small class="tp-combo-cuotas">6 CUOTAS DE $7.483 COP</small>
          <h3 class="tp-combo-card-title">Forro Rígido + Vidrio Pantalla Para Samsung Galaxy S25 Ultra</h3>
          <p class="tp-combo-card-desc">Incluye un estuche rígido transparente en TPU resistente a golpes y un vidrio templado funcional con la huella.</p>
          <div class="tp-combo-card-price">
            <strong>$ 44.900</strong>
          </div>
          <button
            type="button"
            class="tp-combo-btn"
            onclick="if(window.addToCheckout){ window.addToCheckout({ id: 'combo-forro-vidrio-samsung-s25', title: 'Forro Rígido + Vidrio Pantalla Para Samsung Galaxy S25 Ultra', price: 44900, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-samsung.png?v=1791928273', quantity: 1 }, { openDrawer: true }); } else if(window.openCheckout){ window.openCheckout({ id: 'combo-forro-vidrio-samsung-s25', title: 'Forro Rígido + Vidrio Pantalla Para Samsung Galaxy S25 Ultra', price: 44900, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-samsung.png?v=1791928273', quantity: 1 }); }"
          >
            <span>🛒 Añadir combo al carrito</span>
            <span class="tp-combo-btn-arrow">+</span>
          </button>
        </div>
      </article>

      {%- comment -%} Combo 2: Redmi 15C {%- endcomment -%}
      <article class="tp-combo-card">
        <div class="tp-combo-card-img">
          <img src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-redmi15c.jpg?v=1791928273" alt="Combo Celular Redmi 15C 128GB + Vidrio Templado y Forro" loading="lazy">
        </div>
        <div class="tp-combo-card-info">
          <small class="tp-combo-cuotas">6 CUOTAS DE $96.666 COP</small>
          <h3 class="tp-combo-card-title">Combo Celular Redmi 15C 128GB + Vidrio Templado y Forro</h3>
          <p class="tp-combo-card-desc">Celular Xiaomi Redmi 15C (128 GB) nuevo en caja sellada + Vidrio templado 9D de alta definición + Forro protector antigolpes.</p>
          <div class="tp-combo-card-price">
            <strong>$ 580.000</strong>
            <del>$ 650.000</del>
          </div>
          <button
            type="button"
            class="tp-combo-btn"
            onclick="if(window.addToCheckout){ window.addToCheckout({ id: 'combo-redmi-15c-vidrio-forro', title: 'Combo Celular Redmi 15C 128GB + Vidrio Templado y Forro', price: 580000, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-redmi15c.jpg?v=1791928273', quantity: 1 }, { openDrawer: true }); } else if(window.openCheckout){ window.openCheckout({ id: 'combo-redmi-15c-vidrio-forro', title: 'Combo Celular Redmi 15C 128GB + Vidrio Templado y Forro', price: 580000, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-forro-vidrio-redmi15c.jpg?v=1791928273', quantity: 1 }); }"
          >
            <span>🛒 Añadir combo al carrito</span>
            <span class="tp-combo-btn-arrow">+</span>
          </button>
        </div>
      </article>

      {%- comment -%} Combo 3: Samsung Galaxy A07 {%- endcomment -%}
      <article class="tp-combo-card">
        <div class="tp-combo-card-img">
          <img src="https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-samsung-a07-forro-silicona-vidrio.jpg?v=1791928272" alt="Combo Celular Samsung Galaxy A07 64GB + Vidrio Templado y Forro de Silicona" loading="lazy">
        </div>
        <div class="tp-combo-card-info">
          <small class="tp-combo-cuotas">6 CUOTAS DE $70.000 COP</small>
          <h3 class="tp-combo-card-title">Combo Celular Samsung Galaxy A07 64GB + Vidrio Templado y Forro de Silicona</h3>
          <p class="tp-combo-card-desc">Celular Samsung Galaxy A07 (64 GB) nuevo en caja sellada + Vidrio templado premium de borde a borde + Forro en silicona suave con interior gamuzado.</p>
          <div class="tp-combo-card-price">
            <strong>$ 420.000</strong>
            <del>$ 490.000</del>
          </div>
          <button
            type="button"
            class="tp-combo-btn"
            onclick="if(window.addToCheckout){ window.addToCheckout({ id: 'combo-samsung-a07-forro-vidrio', title: 'Combo Celular Samsung Galaxy A07 64GB + Vidrio Templado y Forro de Silicona', price: 420000, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-samsung-a07-forro-silicona-vidrio.jpg?v=1791928272', quantity: 1 }, { openDrawer: true }); } else if(window.openCheckout){ window.openCheckout({ id: 'combo-samsung-a07-forro-vidrio', title: 'Combo Celular Samsung Galaxy A07 64GB + Vidrio Templado y Forro de Silicona', price: 420000, image: 'https://cdn.shopify.com/s/files/1/0667/5903/2972/files/combo-samsung-a07-forro-silicona-vidrio.jpg?v=1791928272', quantity: 1 }); }"
          >
            <span>🛒 Añadir combo al carrito</span>
            <span class="tp-combo-btn-arrow">+</span>
          </button>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .tp-combos-section {
    background: #ffffff !important;
    padding: 70px 0 80px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  }

  .tp-combos-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .tp-combos-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 38px;
    gap: 24px;
  }

  .tp-combos-eyebrow {
    color: #e02424;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 6px;
    display: block;
  }

  .tp-combos-title {
    font-size: 38px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #111111;
    margin: 0;
    line-height: 1.1;
  }

  .tp-combos-desc {
    color: #6b7280;
    font-size: 13.5px;
    line-height: 1.5;
    max-width: 360px;
    text-align: right;
    margin: 0;
  }

  .tp-combos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .tp-combo-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s;
  }

  .tp-combo-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.09);
    border-color: #d1d5db;
  }

  .tp-combo-card-img {
    height: 250px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px;
    border-bottom: 1px solid #f3f4f6;
    overflow: hidden;
  }

  .tp-combo-card-img img {
    max-height: 210px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tp-combo-card:hover .tp-combo-card-img img {
    transform: scale(1.05);
  }

  .tp-combo-card-info {
    padding: 24px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tp-combo-cuotas {
    color: #e02424;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: block;
  }

  .tp-combo-card-title {
    font-size: 18px;
    font-weight: 800;
    color: #111111;
    line-height: 1.3;
    margin: 0 0 10px;
    min-height: 48px;
  }

  .tp-combo-card-desc {
    color: #6b7280;
    font-size: 12.5px;
    line-height: 1.55;
    margin: 0 0 18px;
    min-height: 58px;
    flex: 1;
  }

  .tp-combo-card-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 18px;
    margin-top: auto;
  }

  .tp-combo-card-price strong {
    font-size: 24px;
    font-weight: 900;
    color: #111111;
  }

  .tp-combo-card-price del {
    font-size: 14px;
    color: #9ca3af;
    text-decoration: line-through;
    font-weight: 500;
  }

  .tp-combo-btn {
    background: #e02424;
    color: #ffffff;
    border-radius: 999px;
    padding: 13px 22px;
    font-size: 13.5px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: none;
    cursor: pointer;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
    transition: background 0.2s, transform 0.15s;
  }

  .tp-combo-btn:hover {
    background: #b91c1c;
    transform: translateY(-1px);
  }

  .tp-combo-btn-arrow {
    font-size: 16px;
    transition: transform 0.2s;
  }

  .tp-combo-btn:hover .tp-combo-btn-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 990px) {
    .tp-combos-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tp-combos-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .tp-combos-desc {
      text-align: left;
      max-width: 100%;
    }
    .tp-combo-card-title,
    .tp-combo-card-desc {
      min-height: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Tecno+ Combos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "AHORRA MÁS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Combos Tecno+"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Paquetes seleccionados para llevar más tecnología por un solo precio."
    }
  ],
  "presets": [
    {
      "name": "Tecno+ Combos"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Tecno+ Trust Bar (Beneficios)
{%- endcomment -%}

<section id="beneficios" class="tp-trust-wrapper" aria-labelledby="tp-trust-title-{{ section.id }}">
  <div class="tp-trust-container">
    <div class="tp-trust-heading">
      <span>TECNO+ CONTIGO</span>
      <h2 id="tp-trust-title-{{ section.id }}">Compra con confianza</h2>
      <p>Lo que necesitas para elegir con tranquilidad, antes y después de tu compra.</p>
    </div>
    <div class="tp-trust-grid">
      <div class="tp-trust-item">
        <span class="tp-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h11v11H3zM14 11h4l3 3v4h-7zM7 18.5a1.5 1.5 0 1 0 0 .01M18 18.5a1.5 1.5 0 1 0 0 .01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <b>{{ section.settings.title_1 | default: 'Envíos a Colombia' }}</b>
        <span class="tp-trust-description">{{ section.settings.sub_1 | default: 'Despachos estimados en 24–48 horas, según destino y disponibilidad.' }}</span>
      </div>
      <div class="tp-trust-item">
        <span class="tp-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18M7 15h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </span>
        <b>{{ section.settings.title_2 | default: 'Compra segura' }}</b>
        <span class="tp-trust-description">{{ section.settings.sub_2 | default: 'Consulta los medios de pago disponibles antes de finalizar tu compra.' }}</span>
      </div>
      <div class="tp-trust-item">
        <span class="tp-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 19 6v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <b>{{ section.settings.title_3 | default: 'Garantía' }}</b>
        <span class="tp-trust-description">{{ section.settings.sub_3 | default: 'Respaldo para tus equipos; consulta las condiciones de cada producto.' }}</span>
      </div>
      <div class="tp-trust-item">
        <span class="tp-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M20 11.5a7.5 7.5 0 0 1-11.2 6.5L4 19l1-4.2A7.5 7.5 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 11.5h.01M12 11.5h.01M15 11.5h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </span>
        <b>{{ section.settings.title_4 | default: 'Asesoría local' }}</b>
        <span class="tp-trust-description">{{ section.settings.sub_4 | default: 'Estamos en Montería para orientarte antes de elegir.' }}</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .tp-trust-wrapper {
    background: #ffffff;
    width: 100%;
    padding: 46px 0 52px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
    scroll-margin-top: 100px;
  }

  .tp-trust-container {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .tp-trust-heading {
    max-width: 620px;
    margin: 0 auto 28px;
    text-align: center;
  }

  .tp-trust-heading > span {
    color: #e02424;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .tp-trust-heading h2 {
    margin: 7px 0 8px;
    color: #111111;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .tp-trust-heading p {
    margin: 0;
    color: #70757d;
    font-size: 14px;
    line-height: 1.6;
  }

  .tp-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .tp-trust-item {
    min-height: 168px;
    padding: 22px 18px;
    text-align: center;
    border: 1px solid #eceef1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.045);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .tp-trust-item:hover {
    transform: translateY(-3px);
    border-color: #f3caca;
    box-shadow: 0 14px 30px rgba(17, 24, 39, 0.09);
  }

  .tp-trust-icon {
    width: 42px;
    height: 42px;
    margin-bottom: 13px;
    border-radius: 14px;
    background: #fff0f0;
    color: #e02424;
    display: grid;
    place-items: center;
  }

  .tp-trust-icon svg {
    width: 22px;
    height: 22px;
  }

  .tp-trust-item b {
    display: block;
    font-size: 14px;
    margin-bottom: 7px;
    color: #111111;
    font-weight: 700;
  }

  .tp-trust-description {
    font-size: 12.5px;
    color: #70757d;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .tp-trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tp-trust-wrapper {
      padding: 36px 0 40px;
    }

    .tp-trust-container {
      width: calc(100% - 32px);
    }

    .tp-trust-heading {
      margin-bottom: 22px;
    }

    .tp-trust-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .tp-trust-item {
      min-height: 0;
      padding: 18px;
    }
  }
{% endstylesheet %}


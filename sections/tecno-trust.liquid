      "id": "title_2",
      "label": "Título 2",
      "default": "Compra segura"
    },
    {
      "type": "text",
      "id": "sub_2",
      "label": "Subtítulo 2",
      "default": "Medios de pago disponibles"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Título 3",
      "default": "Garantía"
    },
    {
      "type": "text",
      "id": "sub_3",
      "label": "Subtítulo 3",
      "default": "Respaldo para tus equipos"
    },
    {
      "type": "text",
      "id": "title_4",
      "label": "Título 4",
      "default": "Asesoría local"
    },
    {
      "type": "text",

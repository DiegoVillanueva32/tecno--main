{%- assign bestsellers_collection = section.settings.collection -%}

{%- if bestsellers_collection != blank and bestsellers_collection.products_count > 0 -%}
  <section id="mas-vendidos" class="tp-section tp-bestsellers" aria-labelledby="tp-bestsellers-title-{{ section.id }}">
    <div class="tp-container">
      <div class="tp-head">
        <div>
          <span class="tp-bestsellers-eyebrow">LOS FAVORITOS DE NUESTROS CLIENTES</span>
          <h2 id="tp-bestsellers-title-{{ section.id }}">{{ section.settings.title | default: 'Productos más vendidos' }}</h2>
        </div>
        <p>{{ section.settings.description | default: 'Descubre los productos que más eligen nuestros clientes.' }}</p>
      </div>

      <div class="tp-grid">
        {%- for product in bestsellers_collection.products limit: section.settings.products_to_show -%}
          {% render 'tecno-product-card', product: product, button_theme: 'red' %}
        {%- endfor -%}
      </div>

      <div class="tp-bestsellers-action">
        <a href="{{ bestsellers_collection.url }}" class="tp-bestsellers-button">Ver todos los más vendidos</a>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="tp-bestsellers-editor-note">
    Selecciona una colección de Shopify ordenada por más vendidos para mostrar esta sección en la tienda.
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-bestsellers {
    background: #fff8f8;
    scroll-margin-top: 100px;
  }

  .tp-bestsellers-eyebrow {
    color: #e02424;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .tp-bestsellers-action {
    display: flex;
    justify-content: center;
    margin-top: 34px;
  }

  .tp-bestsellers-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 999px;
    background: #e02424;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .tp-bestsellers-button:hover {
    transform: translateY(-2px);
    background: #b91c1c;
  }

  .tp-bestsellers-editor-note {
    padding: 18px 24px;
    border: 1px dashed #e02424;
    color: #6b2020;
    text-align: center;
    font-size: 13px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tecno+ Más vendidos",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección ordenada por más vendidos",
      "info": "Selecciona una colección de Shopify y ordénala por Más vendidos en el administrador."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Productos más vendidos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Descubre los productos que más eligen nuestros clientes."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Cantidad de productos"
    }
  ],
  "presets": [
    {
      "name": "Tecno+ Más vendidos"
    }
  ]
}
{% endschema %}

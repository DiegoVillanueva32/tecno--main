{%- comment -%}
  Tecno+ Checkout Drawer con Pasarela Oficial Bold.co y Mapa Interactivo de Direcciones de Colombia
  - Pagos 100% seguros y directos con Bold (PSE, Nequi, Tarjetas, Bancolombia) y visualización en mapa de entrega.
{%- endcomment -%}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<div id="tp-checkout-drawer" class="tp-drawer-backdrop" style="display: none;" onclick="if(event.target===this) window.closeCheckout()">
  <div class="tp-drawer-panel" onclick="event.stopPropagation()">
    {%- comment -%} Drawer Header {%- endcomment -%}
    <div class="tp-drawer-header">
      <div class="tp-drawer-header-left">
        <div class="tp-drawer-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <line x1="2" y1="10" x2="22" y2="10" />
          </svg>
        </div>
        <div>
          <div class="tp-drawer-title-row">
            <h2>Finalizar Compra</h2>
            <span class="tp-badge-bold">Bold & Contra Entrega</span>
          </div>
          <p class="tp-drawer-subtitle">Paga online seguro con Bold o en efectivo al recibir con Coordinadora</p>
        </div>
      </div>
      <button type="button" class="tp-drawer-close-btn" onclick="window.closeCheckout()" aria-label="Cerrar checkout">
        ✕
      </button>
    </div>

    {%- comment -%} Drawer Body {%- endcomment -%}
    <div class="tp-drawer-body">
      {%- comment -%} STEP 1: FORMULARIO {%- endcomment -%}
      <div id="tp-checkout-step-form">
        {%- comment -%} Resumen de Compra {%- endcomment -%}
        <div class="tp-order-summary-box">
          <div class="tp-summary-top">
            <span class="tp-summary-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <circle cx="9" cy="21" r="1" />
                <circle cx="20" cy="21" r="1" />
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
              </svg>
              <span>Resumen de tu pedido</span>
            </span>
            <span class="tp-summary-total-price" id="tp-summary-total">$ 0</span>
          </div>

          <div class="tp-summary-items-list" id="tp-summary-items">
            {%- comment -%} Items inyectados por JS {%- endcomment -%}
          </div>

          <div class="tp-summary-shipping">
            <span>Envío a Montería y toda Colombia:</span>
            <span class="tp-free-shipping">¡GRATIS!</span>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 10px; border-top: 1px dashed #e5e7eb;">
            <button type="button" onclick="window.closeCheckout()" style="background: none; border: none; color: #e02424; font-size: 13px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 4px 0;">
              <span>← Añadir más productos</span>
            </button>
            <span style="font-size: 11.5px; color: #9ca3af;">Multicompras habilitadas</span>
          </div>
        </div>

        {%- comment -%} Alerta de Validación {%- endcomment -%}
        <div id="tp-validation-error" class="tp-alert-error" style="display: none;"></div>

        <form id="tp-checkout-form" onsubmit="handleCheckoutSubmit(event)">
          {%- comment -%} SECCIÓN 1: DATOS DE CONTACTO Y ENTREGA {%- endcomment -%}
          <div class="tp-form-section">
            <div class="tp-section-heading">
              <span class="tp-step-number">1</span>
              <h3>Datos de Entrega y Contacto</h3>
            </div>

            <div class="tp-input-group">
              <label for="tp-input-name">Nombre y Apellidos completos *</label>
              <input type="text" id="tp-input-name" required placeholder="Ej. Juan Carlos Pérez">
            </div>

            <div class="tp-input-row">
              <div class="tp-input-group">
                <label for="tp-input-phone">WhatsApp / Celular *</label>
                <input type="tel" id="tp-input-phone" required placeholder="Ej. 304 354 7935">
              </div>
              <div class="tp-input-group">
                <label for="tp-input-email">Correo Electrónico (Para factura Bold) *</label>
                <input type="email" id="tp-input-email" required placeholder="cliente@ejemplo.com">
              </div>
            </div>

            <div class="tp-input-row">
              <div class="tp-input-group">
                <label for="tp-select-doc-type">Tipo de Documento *</label>
                <select id="tp-select-doc-type" required>
                  <option value="CC" selected>Cédula de Ciudadanía (CC)</option>
                  <option value="TI">Tarjeta de Identidad (TI)</option>
                  <option value="CE">Cédula de Extranjería (CE)</option>
                  <option value="PP">Pasaporte</option>
                  <option value="NIT">NIT / RUT</option>
                  <option value="PEP">Permiso Especial (PPT / PEP)</option>
                </select>
              </div>
              <div class="tp-input-group">
                <label for="tp-input-doc">Número de Documento *</label>
                <input type="text" id="tp-input-doc" required placeholder="Ej. 1067894562">
              </div>
            </div>

            {%- comment -%} Selector de Ciudades de Colombia {%- endcomment -%}
            <div class="tp-input-row">
              <div class="tp-input-group">
                <label for="tp-select-city">Ciudad / Municipio de Entrega *</label>
                <select id="tp-select-city" onchange="handleCityChange(this.value)">
                  <optgroup label="Córdoba (Despacho Local Inmediato)">
                    <option value="Montería|Córdoba" selected>Montería (Córdoba)</option>
                    <option value="Cereté|Córdoba">Cereté (Córdoba)</option>
                    <option value="Sahagún|Córdoba">Sahagún (Córdoba)</option>
                    <option value="Lorica|Córdoba">Lorica (Córdoba)</option>
                    <option value="Planeta Rica|Córdoba">Planeta Rica (Córdoba)</option>
                    <option value="Montelíbano|Córdoba">Montelíbano (Córdoba)</option>
                    <option value="Tierralta|Córdoba">Tierralta (Córdoba)</option>
                  </optgroup>
                  <optgroup label="Principales Ciudades de Colombia">
                    <option value="Bogotá D.C.|Cundinamarca">Bogotá D.C. (Cundinamarca)</option>
                    <option value="Medellín|Antioquia">Medellín (Antioquia)</option>
                    <option value="Barranquilla|Atlántico">Barranquilla (Atlántico)</option>
                    <option value="Cartagena|Bolívar">Cartagena (Bolívar)</option>
                    <option value="Cali|Valle del Cauca">Cali (Valle del Cauca)</option>
                    <option value="Bucaramanga|Santander">Bucaramanga (Santander)</option>
                    <option value="Sincelejo|Sucre">Sincelejo (Sucre)</option>
                    <option value="Santa Marta|Magdalena">Santa Marta (Magdalena)</option>
                    <option value="Valledupar|Cesar">Valledupar (Cesar)</option>
                    <option value="Cúcuta|Norte de Santander">Cúcuta (Norte de Santander)</option>
                    <option value="Pereira|Risaralda">Pereira (Risaralda)</option>
                    <option value="Manizales|Caldas">Manizales (Caldas)</option>
                    <option value="Armenia|Quindío">Armenia (Quindío)</option>
                    <option value="Ibagué|Tolima">Ibagué (Tolima)</option>
                    <option value="Villavicencio|Meta">Villavicencio (Meta)</option>
                    <option value="Neiva|Huila">Neiva (Huila)</option>
                    <option value="Pasto|Nariño">Pasto (Nariño)</option>
                    <option value="Popayán|Cauca">Popayán (Cauca)</option>
                    <option value="Riohacha|La Guajira">Riohacha (La Guajira)</option>
                    <option value="Tunja|Boyacá">Tunja (Boyacá)</option>
                    <option value="Otro|Colombia">Otro municipio / ciudad...</option>
                  </optgroup>
                </select>
              </div>

              <div class="tp-input-group" id="tp-custom-city-wrap" style="display: none;">
                <label for="tp-input-custom-city">Escribe tu ciudad y departamento *</label>
                <input type="text" id="tp-input-custom-city" placeholder="Ej. Girardot, Cundinamarca">
              </div>
            </div>

            <div class="tp-input-group">
              <label for="tp-input-address">Dirección exacta de entrega (Calle, Carrera, Manzana, Lote) *</label>
              <input type="text" id="tp-input-address" required placeholder="Ej. Calle 29 # 14 - 35, Barrio La Castellana">
            </div>

            {%- comment -%} Tipo de vivienda {%- endcomment -%}
            <div class="tp-input-group">
              <label>Tipo de lugar de entrega</label>
              <div class="tp-housing-pills">
                <button type="button" class="tp-housing-btn active" data-type="Casa" onclick="setHousingType('Casa', this)">🏠 Casa</button>
                <button type="button" class="tp-housing-btn" data-type="Apartamento" onclick="setHousingType('Apartamento', this)">🏢 Apartamento</button>
                <button type="button" class="tp-housing-btn" data-type="Conjunto" onclick="setHousingType('Conjunto', this)">🏘️ Conjunto</button>
                <button type="button" class="tp-housing-btn" data-type="Local/Oficina" onclick="setHousingType('Local/Oficina', this)">💼 Local / Oficina</button>
              </div>
            </div>

            <div class="tp-input-row">
              <div class="tp-input-group">
                <label for="tp-input-building">Edificio / Conjunto / Apto (Opcional)</label>
                <input type="text" id="tp-input-building" placeholder="Ej. Torre 2 Apto 504">
              </div>
              <div class="tp-input-group">
                <label for="tp-input-ref">Punto de referencia (Opcional)</label>
                <input type="text" id="tp-input-ref" placeholder="Ej. Al lado del Oxxo">
              </div>
            </div>

            {%- comment -%} Ubicación y Mapa Interactivo {%- endcomment -%}
            <div class="tp-map-container-wrap">
              <div class="tp-map-header-row">
                <label class="tp-map-label">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="#e02424"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                  <span>Confirma tu ubicación exacta en el mapa:</span>
                </label>
                <button type="button" class="tp-map-locate-btn" onclick="captureUserGps()">
                  <span>🎯 Mi GPS actual</span>
                </button>
              </div>
              <div class="tp-map-viewport">
                <div id="tp-checkout-map"></div>
                <div class="tp-map-badge-instruction">
                  <span>Arrastra el pin 📍 o toca el mapa para marcar tu casa/edificio</span>
                </div>
              </div>
              <div id="tp-gps-status" class="tp-map-status"></div>
              <input type="hidden" id="tp-input-maps-url" value="">
              <input type="hidden" id="tp-input-lat" value="8.7509">
              <input type="hidden" id="tp-input-lng" value="-75.8814">
            </div>
          </div>

          {%- comment -%} SECCIÓN 2: MÉTODO DE PAGO {%- endcomment -%}
          <div class="tp-form-section">
            <div class="tp-section-heading">
              <span class="tp-step-number">2</span>
              <h3>Método de Pago</h3>
            </div>

            <div class="tp-payment-options">
              {%- comment -%} Pago Contra Entrega con Coordinadora {%- endcomment -%}
              <label class="tp-pay-option" id="tp-pay-opt-cod" onclick="selectPaymentMethod('cod')">
                <input type="radio" name="payment_method" value="cod" onchange="selectPaymentMethod('cod')">
                <div class="tp-pay-content">
                  <div class="tp-pay-title-row">
                    <span class="tp-pay-title">Pago Contra Entrega (Coordinadora)</span>
                    <span class="tp-pay-badge-cod">PAGA EN CASA</span>
                  </div>
                  <p class="tp-pay-desc">
                    Pagas en efectivo al transportador de <b>Coordinadora</b> cuando recibas el paquete en tu puerta. Sin anticipos.
                  </p>
                  <div class="tp-pay-badges">
                    <span class="tp-brand-badge coord">📦 Coordinadora</span>
                    <span class="tp-brand-badge cash">💵 Efectivo al recibir</span>
                    <span class="tp-brand-badge check">✓ 100% Confiable</span>
                  </div>
                </div>
              </label>

              {%- comment -%} Pasarela Bold (Pago Online Inmediato) {%- endcomment -%}
              <label class="tp-pay-option active" id="tp-pay-opt-bold" onclick="selectPaymentMethod('bold')">
                <input type="radio" name="payment_method" value="bold" checked onchange="selectPaymentMethod('bold')">
                <div class="tp-pay-content">
                  <div class="tp-pay-title-row">
                    <span class="tp-pay-title">Pago Online Inmediato (Bold.co)</span>
                    <span class="tp-pay-rec-badge">PSE / TARJETAS</span>
                  </div>
                  <p class="tp-pay-desc">
                    Pagas de inmediato con Tarjetas de Crédito / Débito, PSE, Nequi o Botón Bancolombia con cifrado bancario TLS.
                  </p>
                  <div class="tp-pay-badges">
                    <span class="tp-brand-badge visa">VISA</span>
                    <span class="tp-brand-badge mastercard">Mastercard</span>
                    <span class="tp-brand-badge pse">PSE</span>
                    <span class="tp-brand-badge nequi">Nequi</span>
                    <span class="tp-brand-badge bancolombia">Bancolombia</span>
                  </div>
                </div>
              </label>
            </div>
          </div>

          {%- comment -%} Botón de Envío / Pago {%- endcomment -%}
          <div class="tp-submit-wrap">
            <button type="submit" id="tp-submit-btn" class="tp-submit-btn">
              <span id="tp-submit-btn-text">Pagar con Bold $ 0</span>
              <span>→</span>
            </button>
            <div class="tp-trust-footer" id="tp-trust-footer">
              <span>🔒 Pasarela Bold.co</span>
              <span>·</span>
              <span>Protección al Comprador</span>
              <span>·</span>
              <span>Despacho 24-48h</span>
            </div>
          </div>
        </form>
      </div>

      {%- comment -%} STEP 2: PROCESANDO CON BOLD {%- endcomment -%}
      <div id="tp-checkout-step-bold" style="display: none;" class="tp-bold-ready-view">
        <div class="tp-bold-header-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <line x1="2" y1="10" x2="22" y2="10" />
          </svg>
        </div>
        <h3>¡Tu orden está lista para pagar!</h3>
        <p class="tp-bold-subtitle">Haz clic en el botón oficial de Bold para completar tu pago de forma 100% segura con PSE, Nequi o Tarjeta.</p>

        <div class="tp-bold-order-card">
          <div class="tp-bold-row">
            <span>Referencia de Pedido:</span>
            <b id="tp-bold-order-ref" class="font-mono">TP-000000</b>
          </div>
          <div class="tp-bold-row border-top">
            <span>Total a Pagar:</span>
            <b id="tp-bold-order-amount" class="tp-bold-amount">$ 0</b>
          </div>
        </div>

        {%- comment -%} Contenedor donde Bold inyecta su botón embebido {%- endcomment -%}
        <div id="tp-bold-button-mount" class="tp-bold-mount">
          <div class="tp-bold-loading-spinner"></div>
          <p style="font-size: 12px; color: #70757d; margin-top: 8px;">Cargando botón seguro de Bold.co...</p>
        </div>

        <button type="button" class="tp-bold-back-btn" onclick="returnToCheckoutForm()">
          ← Volver y editar datos de entrega
        </button>
      </div>

      {%- comment -%} STEP 3: SUCCESS (CONTRA ENTREGA) {%- endcomment -%}
      <div id="tp-checkout-step-success" style="display: none;" class="tp-success-view">
        <div class="tp-success-icon">✓</div>
        <span class="tp-badge-success">¡Pedido Confirmado!</span>
        <h3 id="tp-success-client-name">¡Gracias por tu compra!</h3>
        <p class="tp-success-desc">
          Tu pedido ha sido registrado con éxito para <b>Pago Contra Entrega con Coordinadora</b>. Te enviaremos el número de guía para que puedas rastrear tu paquete.
        </p>

        <div class="tp-receipt-box">
          <div class="tp-receipt-row">
            <span>Número de Pedido:</span>
            <b id="tp-receipt-id" class="font-mono">TP-0000</b>
          </div>
          <div class="tp-receipt-row">
            <span>Total a Pagar al Recibir:</span>
            <b id="tp-receipt-total" class="tp-bold-amount">$ 0</b>
          </div>
          <div class="tp-receipt-row">
            <span>Transportadora:</span>
            <b style="color: #0284c7;">📦 Coordinadora (RAD - Recaudo Contra Entrega)</b>
          </div>
          <div class="tp-receipt-row">
            <span>Método de Pago:</span>
            <b>Efectivo al recibir en tu puerta</b>
          </div>
          <div class="tp-receipt-row">
            <span>Dirección de Entrega:</span>
            <span id="tp-receipt-address" style="text-align: right; font-weight: 600;"></span>
          </div>
        </div>

        <!-- Confirmación de Notificación Automática al Correo Oficial -->
        <div style="margin-top: 18px; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 14px; padding: 16px; text-align: left;">
          <div style="display: flex; align-items: center; gap: 8px; font-weight: 800; color: #166534; font-size: 13.5px;">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Notificación Enviada Automáticamente</span>
          </div>
          <p style="font-size: 12px; color: #15803d; line-height: 1.45; margin: 6px 0 0;">
            Los detalles y especificaciones completas de este pedido se han enviado de forma 100% automática al correo de despacho: <b style="color: #0f172a; word-break: break-all;">martinezserpa23@gmail.com</b>
          </p>
        </div>

        <button type="button" class="tp-submit-btn" style="margin-top: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 100%; border: none;" onclick="window.closeCheckout(); location.reload();">
          Seguir Explorando Catálogo
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .tp-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    z-index: 999999;
    display: flex;
    justify-content: flex-end;
    animation: tpFadeIn 0.25s ease;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  }

  @keyframes tpFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .tp-drawer-panel {
    background: #ffffff;
    width: 100%;
    max-width: 520px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.25);
    animation: tpSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes tpSlideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .tp-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #e8e8ea;
    background: #fafafa;
  }

  .tp-drawer-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tp-drawer-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #111111;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tp-drawer-icon-box svg {
    width: 18px;
    height: 18px;
  }

  .tp-drawer-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tp-drawer-title-row h2 {
    font-size: 16px;
    font-weight: 900;
    color: #111111;
    margin: 0;
  }

  .tp-badge-bold {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
  }

  .tp-drawer-subtitle {
    font-size: 11px;
    color: #70757d;
    margin: 2px 0 0;
  }

  .tp-drawer-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #6b7280;
    cursor: pointer;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }

  .tp-drawer-close-btn:hover {
    background: #f3f4f6;
    color: #111111;
  }

  .tp-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  /* Order Summary */
  .tp-order-summary-box {
    background: #fafafa;
    border: 1px solid #e8e8ea;
    border-radius: 16px;
    padding: 14px 16px;
    margin-bottom: 20px;
  }

  .tp-summary-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 10px;
  }

  .tp-summary-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 800;
    color: #111111;
  }

  .tp-summary-total-price {
    font-size: 15px;
    font-weight: 900;
    color: #e02424;
  }

  .tp-summary-items-list {
    margin: 10px 0;
    max-height: 140px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tp-summary-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 11.5px;
    color: #374151;
  }

  .tp-summary-item-left {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;

    window.captureUserGps = function() {
      var statusEl = document.getElementById("tp-gps-status");
      var mapsInput = document.getElementById("tp-input-maps-url");
      if (!navigator.geolocation) {
        if (statusEl) statusEl.textContent = "Geolocalización no soportada en este navegador.";
        return;
      }
      if (statusEl) statusEl.textContent = "Buscando coordenadas GPS...";

      navigator.geolocation.getCurrentPosition(
        function(position) {
          var lat = position.coords.latitude;
          var lng = position.coords.longitude;
          currentCoords = { lat: lat, lng: lng };
          var mapsUrl = "https://www.google.com/maps?q=" + lat.toFixed(6) + "," + lng.toFixed(6);
          if (mapsInput) mapsInput.value = mapsUrl;
          var latInput = document.getElementById("tp-input-lat");
          if (latInput) latInput.value = lat.toFixed(6);
          var lngInput = document.getElementById("tp-input-lng");
          if (lngInput) lngInput.value = lng.toFixed(6);
          if (checkoutMap && checkoutMarker) {
            checkoutMap.flyTo([lat, lng], 17);
            checkoutMarker.setLatLng([lat, lng]);
          }
          if (statusEl) statusEl.textContent = "✓ Ubicación GPS fijada correctamente en el mapa";
        },
        function(err) {
          if (statusEl) statusEl.textContent = "Permiso de ubicación denegado o no disponible.";
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    };

    // Procesar Formulario con Bold Oficial
    window.handleCheckoutSubmit = async function(e) {
      e.preventDefault();
      var errEl = document.getElementById("tp-validation-error");
      if (errEl) errEl.style.display = "none";

      var name = document.getElementById("tp-input-name").value.trim();
      var phone = document.getElementById("tp-input-phone").value.trim();
      var email = document.getElementById("tp-input-email").value.trim();
      var docTypeSelect = document.getElementById("tp-select-doc-type");
      var docType = docTypeSelect ? docTypeSelect.value : "CC";
      var doc = document.getElementById("tp-input-doc").value.trim();
      var address = document.getElementById("tp-input-address").value.trim();
      var citySelectVal = document.getElementById("tp-select-city").value;
      var building = document.getElementById("tp-input-building").value.trim();
      var refPoint = document.getElementById("tp-input-ref").value.trim();
      var mapsUrl = document.getElementById("tp-input-maps-url").value;

      var city = "Montería";
      var dept = "Córdoba";

      if (citySelectVal === "Otro|Colombia") {
        var customCity = document.getElementById("tp-input-custom-city").value.trim();
        if (!customCity) {
          if (errEl) {
            errEl.textContent = "Por favor escribe tu ciudad y departamento.";
            errEl.style.display = "block";
          }
          return;
        }
        city = customCity;
        dept = "Colombia";
      } else {
        var parts = citySelectVal.split("|");
        city = parts[0];
        dept = parts[1] || "Córdoba";
      }

      if (!name || !phone || !email || !address || !doc) {
        if (errEl) {
          errEl.textContent = "Por favor completa todos los campos requeridos (*), incluyendo tu documento de identidad.";
          errEl.style.display = "block";
        }
        return;
      }

      var fullShippingAddress = address + " (" + currentHousingType + ")";
      if (building) fullShippingAddress += ", " + building;
      if (refPoint) fullShippingAddress += " [Ref: " + refPoint + "]";
      if (mapsUrl) fullShippingAddress += " [GPS: " + mapsUrl + "]";

      var total = getCheckoutTotal();
      if (total <= 0) {
        if (errEl) {
          errEl.textContent = "El carrito no tiene productos válidos.";
          errEl.style.display = "block";
        }
        return;
      }

      // Guardar en localStorage para próximas compras
      saveCustomerData({
        name: name,
        phone: phone,
        email: email,
        docType: docType,
        doc: doc,
        address: address,
        cityDept: citySelectVal
      });

      // Mostrar estado de carga en el botón
      var submitBtn = document.getElementById("tp-submit-btn");
      var submitBtnText = document.getElementById("tp-submit-btn-text");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = "0.7";
      }
      if (submitBtnText) {
        submitBtnText.textContent = currentPaymentMethod === "cod" ? "Confirmando pedido..." : "Conectando con Bold...";
      }

      // Sincronización silenciosa en background con Shopify (sin bloquear la compra bajo ninguna circunstancia)
      try {
        fetch("/cart/update.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            note: "PEDIDO " + (currentPaymentMethod === "cod" ? "CONTRA ENTREGA (COORDINADORA)" : "BOLD") + 
                  " | Doc: " + docType + " " + doc + 
                  " | Tel: " + phone + 
                  " | Dir: " + fullShippingAddress + 
                  (mapsUrl ? " | GPS: " + mapsUrl : ""),
            attributes: {
              "Tipo de Documento": docType,
              "Número de Documento": doc,
              "Celular / WhatsApp": phone,
              "Tipo de Vivienda": currentHousingType,
              "Torre / Apto": building || "N/A",
              "Punto de Referencia": refPoint || "N/A",
              "Ubicación GPS": mapsUrl || "No indicada",
              "Método de Pago Preferido": currentPaymentMethod === "cod" ? "Pago Contra Entrega con Coordinadora" : "Bold Pasarela Online"
            }
          })
        }).catch(function() {});
      } catch(e) {}

      // Procesar Pedido: Contra Entrega
      if (currentPaymentMethod === "cod") {
        document.getElementById("tp-checkout-step-form").style.display = "none";
        document.getElementById("tp-checkout-step-bold").style.display = "none";
        document.getElementById("tp-checkout-step-success").style.display = "block";

        var randomCode = Math.floor(1000 + Math.random() * 9000);
        var dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, "");
        var orderNumber = "TP-COD-" + dateStr + "-" + randomCode;

        var clientNameEl = document.getElementById("tp-success-client-name");
        if (clientNameEl) clientNameEl.textContent = "¡Gracias, " + name + "!";

        var receiptIdEl = document.getElementById("tp-receipt-id");
        if (receiptIdEl) receiptIdEl.textContent = orderNumber;

        var receiptTotalEl = document.getElementById("tp-receipt-total");
        if (receiptTotalEl) receiptTotalEl.textContent = formatCop(total);

        var receiptAddressEl = document.getElementById("tp-receipt-address");
        if (receiptAddressEl) receiptAddressEl.textContent = fullShippingAddress + " - " + city + ", " + dept;

        // Limpiar carrito tras confirmar pedido
        var savedItems = [].concat(checkoutItems);
        checkoutItems = [];
        saveCheckoutCart();
        renderSummary();

        // Enviar notificación completa de pedido por correo a martinezserpa23@gmail.com
        sendOrderEmailNotification({
          orderNumber: orderNumber,
          paymentMethod: "cod",
          total: total,
          name: name,
          docType: docType,
          doc: doc,
          phone: phone,
          email: email,
          city: city,
          dept: dept,
          fullShippingAddress: fullShippingAddress,
          building: building,
          refPoint: refPoint,
          mapsUrl: mapsUrl,
          items: savedItems
        });

        return;
      }

      // Flujo Oficial de Pago Bold.co
      document.getElementById("tp-checkout-step-form").style.display = "none";
      document.getElementById("tp-checkout-step-bold").style.display = "flex";

      var randomCode = Math.floor(10000 + Math.random() * 90000);
      var dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, "");
      var orderNumber = "TP-BOLD-" + dateStr + "-" + randomCode;

      document.getElementById("tp-bold-order-ref").textContent = orderNumber;
      document.getElementById("tp-bold-order-amount").textContent = formatCop(total);

      // Enviar notificación completa de pedido Bold por correo a martinezserpa23@gmail.com
      sendOrderEmailNotification({
        orderNumber: orderNumber,
        paymentMethod: "bold",
        total: total,
        name: name,
        docType: docType,
        doc: doc,
        phone: phone,
        email: email,
        city: city,
        dept: dept,
        fullShippingAddress: fullShippingAddress,
        building: building,
        refPoint: refPoint,
        mapsUrl: mapsUrl,
        items: checkoutItems
      });

      var mount = document.getElementById("tp-bold-button-mount");
      mount.innerHTML =
        '<div id="tp-bold-loader" style="text-align: center; padding: 14px 0;">' +
          '<div class="tp-bold-loading-spinner" style="margin: 0 auto;"></div>' +
          '<p style="font-size: 13px; color: #4b5563; margin-top: 10px; font-weight: 600;">Cargando pasarela oficial de Bold.co...</p>' +
        '</div>';

      var customerData = JSON.stringify({
        email: email,
        fullName: name,
        phone: phone,
        dialCode: "+57",
        documentNumber: doc,
        documentType: docType || "CC"
      });

      var billingAddress = JSON.stringify({
        address: fullShippingAddress,
        city: city,
        state: dept,
        country: "CO"
      });

      try {
        var integritySignature = await computeBoldSignature(orderNumber, Math.round(total), "COP");

        // Crear script oficial de Bold
        var boldScript = document.createElement("script");
        boldScript.setAttribute("data-bold-button", "dark-L");
        boldScript.setAttribute("data-api-key", BOLD_API_KEY);
        boldScript.setAttribute("data-order-id", orderNumber);
        boldScript.setAttribute("data-amount", String(Math.round(total)));
        boldScript.setAttribute("data-currency", "COP");
        boldScript.setAttribute("data-integrity-signature", integritySignature);
        boldScript.setAttribute("data-description", ("Tecno+ Pedido " + orderNumber).substring(0, 100));
        boldScript.setAttribute("data-redirection-url", window.location.origin + "/collections/all");
        boldScript.setAttribute("data-render-mode", "embedded");
        boldScript.setAttribute("data-customer-data", customerData);
        boldScript.setAttribute("data-billing-address", billingAddress);

        // Inyectar en el contenedor
        mount.appendChild(boldScript);

        // Ocultar spinner cuando Bold inserte el botón
        var obs = new MutationObserver(function() {
          var loader = document.getElementById("tp-bold-loader");
          if (loader && mount.querySelector('.boldPaymentButton, iframe, [class*="bold"]')) {
            loader.style.display = "none";
            obs.disconnect();
          }
        });
        obs.observe(mount, { childList: true, subtree: true });

        // Remover librería previa y recargar
        var existingLib = document.getElementById("bold-lib-script");
        if (existingLib) existingLib.remove();

        var lib = document.createElement("script");
        lib.id = "bold-lib-script";
        lib.src = "https://checkout.bold.co/library/boldPaymentButton.js";
        lib.async = true;
        lib.onload = function() {
          setTimeout(function() {
            var loader = document.getElementById("tp-bold-loader");
            if (loader) loader.style.display = "none";
          }, 800);
        };
        lib.onerror = function() {
          var loader = document.getElementById("tp-bold-loader");
          if (loader) {
            loader.innerHTML = '<p style="color: #e02424; font-size: 13px; font-weight: 700;">No se pudo conectar con el servidor de Bold. Por favor verifica tu conexión a internet.</p>';
          }
        };
        document.head.appendChild(lib);

        // Registro opcional en background
        try {
          var payload = {
            customer_name: name,
            customer_email: email,
            customer_phone: phone,
            customer_id_number: doc,
            department: dept,
            city: city,
            shipping_address: fullShippingAddress,
            payment_method: "bold",
            items: checkoutItems
          };
          fetch(BACKEND_API_URL + "/api/bold/checkout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          }).catch(function() {});
        } catch(e) {}

      } catch(err) {
        console.error("Error al inicializar Bold:", err);
        mount.innerHTML = '<p style="color: #e02424; font-size: 13px; font-weight: 700;">Error al generar el pago con Bold. Por favor reintenta.</p>';
      }
    };

    // Inicializar carrito persistente y badges al cargar página
    loadSavedCart();
    updateCartBadges();
  })();
</script>

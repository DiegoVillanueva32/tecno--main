    // Mostrar notificación Toast visual no intrusiva
    window.showTecnoToast = function(msg, actionText, actionFn) {
      var toast = document.getElementById("tp-global-toast");
      if (!toast) {
        toast = document.createElement("div");
        toast.id = "tp-global-toast";
        toast.style.cssText = "position: fixed; bottom: 24px; right: 24px; z-index: 999999; background: #111827; color: #ffffff; padding: 14px 20px; border-radius: 12px; font-size: 13.5px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: flex; align-items: center; gap: 14px; max-width: 90vw; border: 1px solid #374151;";
        document.body.appendChild(toast);
      }
      toast.innerHTML = '<span>' + msg + '</span>' +
        (actionText ? '<button type="button" id="tp-toast-action-btn" style="background: #e02424; color: #fff; border: none; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 12px; cursor: pointer;">' + actionText + '</button>' : '');
      toast.style.display = "flex";

      if (actionText && actionFn) {
        var actBtn = document.getElementById("tp-toast-action-btn");
        if (actBtn) {
          actBtn.onclick = function() {
            toast.style.display = "none";
            actionFn();
          };
        }
      }

      clearTimeout(window.__tpToastTimer);
      window.__tpToastTimer = setTimeout(function() {
        if (toast) toast.style.display = "none";
      }, 4500);
    };

    window.updateCartItemQty = function(idx, delta) {
      if (checkoutItems[idx]) {
        var newQty = (checkoutItems[idx].quantity || 1) + delta;
        if (newQty <= 0) {
          checkoutItems.splice(idx, 1);
        } else {
          checkoutItems[idx].quantity = newQty;
        }
        saveCheckoutCart();
        renderSummary();
      }
    };

    window.removeCartItem = function(idx) {
      if (checkoutItems[idx]) {
        checkoutItems.splice(idx, 1);
        saveCheckoutCart();
        renderSummary();
      }
    };

    // Añadir uno o más items al carrito sin borrar los anteriores (Multicompras)
    window.addToCheckout = function(itemOrItems, options) {
      if (!itemOrItems) return;
      options = options || {};
      var incoming = Array.isArray(itemOrItems) ? itemOrItems : [itemOrItems];

      incoming.forEach(function(newItem) {
        if (!newItem) return;
        var newId = String(newItem.id || newItem.code || newItem.title);
        var existing = checkoutItems.find(function(it) {
          return String(it.id) === newId;
        });
        var qtyToAdd = Number(newItem.quantity) || 1;
        if (existing) {
          existing.quantity = (Number(existing.quantity) || 1) + qtyToAdd;
        } else {
          checkoutItems.push({
            id: newId,
            title: newItem.title || newItem.name || "Producto",
            price: Number(newItem.price) || 0,
            image: newItem.image || "",
            quantity: qtyToAdd
          });
        }
      });

      saveCheckoutCart();
      renderSummary();

      if (options.openDrawer) {
        window.openCheckout();
      } else {
        var firstTitle = incoming[0] && (incoming[0].title || incoming[0].name) ? (incoming[0].title || incoming[0].name) : "Producto";
        var count = incoming.reduce(function(acc, it) { return acc + (Number(it.quantity) || 1); }, 0);
        window.showTecnoToast("🛒 " + (incoming.length === 1 ? firstTitle : count + " productos agregados") + " al carrito", "Ver Carrito", function() {
          window.openCheckout();
        });
      }
    };

    // API Global para abrir checkout desde cualquier parte del sitio
    window.openCheckout = function(itemOrItems) {
      if (itemOrItems) {
        // En vez de reemplazar y borrar compras anteriores, se añaden para permitir multicompras
        window.addToCheckout(itemOrItems, { openDrawer: false });
      } else if (!checkoutItems || checkoutItems.length === 0) {
        loadSavedCart();
      }

      // Resetear a paso 1
      document.getElementById("tp-checkout-step-form").style.display = "block";
      document.getElementById("tp-checkout-step-bold").style.display = "none";
      document.getElementById("tp-checkout-step-success").style.display = "none";

      renderSummary();
      loadSavedCustomerData();

      var drawer = document.getElementById("tp-checkout-drawer");
      if (drawer) {
        drawer.style.display = "flex";
        document.body.style.overflow = "hidden";
      }

      // Inicializar y renderizar mapa correctamente al abrir
      setTimeout(function() {
        initCheckoutMap();
        if (checkoutMap) checkoutMap.invalidateSize();
      }, 300);
    };


    // Abrir checkout con el producto actual desde cualquier botón de ficha de producto
    window.openProductCheckout = function(btn) {
      var title = (btn && btn.getAttribute("data-product-title")) || (document.querySelector('.product__title h1, .product__title') ? document.querySelector('.product__title h1, .product__title').textContent.trim() : "Producto");
      var priceAttr = btn && btn.getAttribute("data-product-price");
      var price = priceAttr ? Number(priceAttr) : 0;
      if (!price || isNaN(price)) {
        var priceEl = document.querySelector('.price__regular .price-item--regular, .price-item--sale, .product__price .price, .price');
        if (priceEl) {
          price = Number(priceEl.textContent.replace(/[^\d]/g, "")) || 0;
        }
      }
      var img = (btn && btn.getAttribute("data-product-image")) || (document.querySelector('.product__media img, .product-media-modal__content img') ? document.querySelector('.product__media img, .product-media-modal__content img').src : "");
      var id = (btn && btn.getAttribute("data-product-id")) || title.toLowerCase().replace(/[^a-z0-9]+/g, "-");

      var qtyInput = document.querySelector('quantity-input input[name="quantity"], input[name="quantity"]');
      var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;

      window.openCheckout({
        id: id,
        title: title,
        price: price,
        image: img,
        quantity: qty
      });
    };

    // Abrir checkout leyendo los items actuales del carrito de Shopify
    window.openCheckoutFromCart = async function(e) {
      if (e && e.preventDefault) e.preventDefault();
      if (e && e.stopPropagation) e.stopPropagation();
      try {
        var res = await fetch('/cart.js');
        var cart = await res.json();
        if (cart && cart.items && cart.items.length > 0) {
          var items = cart.items.map(function(item) {
            return {
              id: item.variant_id || item.id,
              title: item.title || item.product_title,
              price: Math.round(item.price / 100),
              image: item.image || (item.featured_image ? item.featured_image.url : ''),
              quantity: item.quantity || 1
            };
          });
          // Cerrar cart drawer nativo de Shopify si está abierto
          var nativeCartDrawer = document.querySelector('cart-drawer');
          if (nativeCartDrawer && nativeCartDrawer.classList.contains('active')) {
            nativeCartDrawer.classList.remove('active');
          }
          var nativeDetails = document.querySelector('cart-drawer details');
          if (nativeDetails) nativeDetails.removeAttribute('open');

          window.openCheckout(items);
          return;
        }
      } catch(err) {
        console.warn("Error leyendo carrito nativo:", err);
      }
      window.openCheckout();
    };

    // Interceptor global para bloquear cualquier intento de ir al checkout nativo de Shopify
    document.addEventListener("click", function(e) {
      var checkoutTrigger = e.target.closest('button[name="checkout"], #CartDrawer-Checkout, #checkout, .cart__checkout-button, a[href="/checkout"], a[href^="/checkout"], [data-testid="Checkout-button"], .shopify-payment-button');
      if (checkoutTrigger) {
        e.preventDefault();
        e.stopPropagation();
        window.openCheckoutFromCart(e);
        return false;
      }
    }, true);

    window.closeCheckout = function() {
      var drawer = document.getElementById("tp-checkout-drawer");
      if (drawer) drawer.style.display = "none";
      document.body.style.overflow = "";
    };

    window.handleCityChange = function(val) {
      var customWrap = document.getElementById("tp-custom-city-wrap");
      if (val === "Otro|Colombia") {
        if (customWrap) customWrap.style.display = "block";
      } else {
        if (customWrap) customWrap.style.display = "none";
      }

      var cityName = (val || "").split("|")[0];
      if (COLOMBIA_CITY_COORDS[cityName]) {
        var coords = COLOMBIA_CITY_COORDS[cityName];
        currentCoords = { lat: coords[0], lng: coords[1] };
        if (checkoutMap && checkoutMarker) {
          checkoutMap.flyTo(coords, 15);
          checkoutMarker.setLatLng(coords);
          var mapsInput = document.getElementById("tp-input-maps-url");
          if (mapsInput) mapsInput.value = "https://www.google.com/maps?q=" + coords[0].toFixed(6) + "," + coords[1].toFixed(6);
          var latInput = document.getElementById("tp-input-lat");
          if (latInput) latInput.value = coords[0].toFixed(6);
          var lngInput = document.getElementById("tp-input-lng");
          if (lngInput) lngInput.value = coords[1].toFixed(6);

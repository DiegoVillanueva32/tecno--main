    var checkoutMap = null;
    var checkoutMarker = null;
    var currentCoords = { lat: 8.7509, lng: -75.8814 };

    function initCheckoutMap() {
      var container = document.getElementById("tp-checkout-map");
      if (!container || checkoutMap || typeof L === "undefined") return;
      try {
        checkoutMap = L.map("tp-checkout-map", {
          center: [currentCoords.lat, currentCoords.lng],
          zoom: 15,
          zoomControl: true,
          attributionControl: false
        });

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19
        }).addTo(checkoutMap);

        var redIcon = L.divIcon({
          className: "tp-custom-red-pin",
          html: '<div style="position: relative; width: 32px; height: 38px; transform: translate(-50%, -100%); filter: drop-shadow(0 4px 6px rgba(0,0,0,0.35));">' +
                '<svg viewBox="0 0 24 24" width="32" height="38" fill="none"><path d="M12 0C7.58 0 4 3.58 4 8c0 5.25 7.13 13.32 7.43 13.66.3.34.84.34 1.14 0C12.87 21.32 20 13.25 20 8c0-4.42-3.58-8-8-8z" fill="#E02424"/><circle cx="12" cy="8" r="3.5" fill="#FFFFFF"/></svg>' +
                '</div>',
          iconSize: [32, 38],
          iconAnchor: [16, 38]
        });

        checkoutMarker = L.marker([currentCoords.lat, currentCoords.lng], {
          icon: redIcon,
          draggable: true
        }).addTo(checkoutMap);

        function updateLocation(lat, lng) {
          currentCoords = { lat: lat, lng: lng };
          var mapsUrl = "https://www.google.com/maps?q=" + lat.toFixed(6) + "," + lng.toFixed(6);
          var mapsInput = document.getElementById("tp-input-maps-url");
          if (mapsInput) mapsInput.value = mapsUrl;
          var latInput = document.getElementById("tp-input-lat");
          if (latInput) latInput.value = lat.toFixed(6);
          var lngInput = document.getElementById("tp-input-lng");
          if (lngInput) lngInput.value = lng.toFixed(6);
          var statusEl = document.getElementById("tp-gps-status");
          if (statusEl) statusEl.textContent = "📍 Ubicación fijada: " + lat.toFixed(4) + ", " + lng.toFixed(4);
        }

        checkoutMarker.on("dragend", function() {
          var pos = checkoutMarker.getLatLng();
          updateLocation(pos.lat, pos.lng);
        });

        checkoutMap.on("click", function(e) {
          checkoutMarker.setLatLng(e.latlng);
          updateLocation(e.latlng.lat, e.latlng.lng);
        });

        updateLocation(currentCoords.lat, currentCoords.lng);
      } catch(err) {
        console.warn("Map init warning:", err);
      }
    }

    // Autocompletar datos previos
    function loadSavedCustomerData() {
      try {
        var saved = localStorage.getItem("tecnoplus_customer_info");
        if (saved) {
          var parsed = JSON.parse(saved);
          if (parsed.name) document.getElementById("tp-input-name").value = parsed.name;
          if (parsed.phone) document.getElementById("tp-input-phone").value = parsed.phone;
          if (parsed.email) document.getElementById("tp-input-email").value = parsed.email;
          if (parsed.docType && document.getElementById("tp-select-doc-type")) {
            document.getElementById("tp-select-doc-type").value = parsed.docType;
          }
          if (parsed.doc) document.getElementById("tp-input-doc").value = parsed.doc;
          if (parsed.address) document.getElementById("tp-input-address").value = parsed.address;
          if (parsed.cityDept) {
            var citySelect = document.getElementById("tp-select-city");
            if (citySelect) {
              citySelect.value = parsed.cityDept;
              handleCityChange(parsed.cityDept);
            }
          }
        }
      } catch(e) {}
    }


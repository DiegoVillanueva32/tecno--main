{%- comment -%}
  Tecno+ Scroll To Top Button
{%- endcomment -%}

<button
  type="button"
  id="tp-scroll-top"
  class="tp-scroll-top"
  aria-label="Volver arriba"
  onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
</button>

<style>
  .tp-scroll-top {
    position: fixed;
    right: 27px;
    bottom: 92px;
    z-index: 998;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #e02424;
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(224, 36, 36, 0.4);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
  }

  .tp-scroll-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .tp-scroll-top:hover {
    background: #b91c1c;
    transform: scale(1.1);
    box-shadow: 0 8px 24px rgba(224, 36, 36, 0.55);
  }
</style>

<script>
  (function() {
    var btn = document.getElementById('tp-scroll-top');
    if (btn) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 300) {
          btn.classList.add('visible');
        } else {
          btn.classList.remove('visible');
        }
      }, { passive: true });
    }
  })();
</script>
